---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BlogGrid from '../../../components/BlogGrid.astro';
import Hero from '../../../layouts/Hero.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import TagList from '../../../components/TagList.astro';
import ProgrammingBlogHeader from '../../../components/ProgrammingBlogHeader.astro';
import WonderBlogHeader from '../../../components/WonderBlogHeader.astro';
import { getAllPostsSorted, getUniqueTags } from '../../../scripts/utilities.ts';
import { PaginationRepository } from '../../../scripts/pagination.ts';
import { PROGRAMMING_BLOG_TYPE, WONDER_BLOG_TYPE } from '../../../scripts/constants.ts';

// Three paginated views: /blog/programming, /blog/wonder, and /blog (all posts).
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    // Defined inside: Astro hoists getStaticPaths, so it can't see module-level constants.
    const PAGE_SIZE = 12;
    const allPosts = await getAllPostsSorted();

    const byBlogType = [PROGRAMMING_BLOG_TYPE, WONDER_BLOG_TYPE].flatMap((blogType) => {
        const posts = allPosts.filter((post) => post.data.blog.includes(blogType));
        return paginate(posts, {
            params: { blog_type: blogType },
            props: { blogType, tags: getUniqueTags(posts) },
            pageSize: PAGE_SIZE,
        });
    });

    const all = paginate(allPosts, {
        params: { blog_type: undefined },
        props: { blogType: undefined, tags: getUniqueTags(allPosts) },
        pageSize: PAGE_SIZE,
    });

    return [...byBlogType, ...all];
}

type Props = {
    page: Page<CollectionEntry<'posts'>>;
    blogType: typeof PROGRAMMING_BLOG_TYPE | typeof WONDER_BLOG_TYPE | undefined;
    tags: string[];
};

const { page, blogType, tags } = Astro.props;
const paginationRepository = new PaginationRepository(page);

const blogTitles = {
    [PROGRAMMING_BLOG_TYPE]: 'Programming Blog',
    [WONDER_BLOG_TYPE]: 'Wonder Blog',
};
const baseTitle = blogType ? blogTitles[blogType] : 'All Posts';
const title = page.currentPage > 1 ? `${baseTitle} – Page ${page.currentPage}` : baseTitle;
const descriptions = {
    [PROGRAMMING_BLOG_TYPE]: "Eman's programming blog: Swift, iOS, and software design.",
    [WONDER_BLOG_TYPE]: "Eman's Wonder Blog: the paradoxes and possibilities of life, art and science.",
};
const description = blogType ? descriptions[blogType] : "Explore all of Eman's blog posts.";
---

<MainLayout title={title} description={description}>
    {
        blogType === WONDER_BLOG_TYPE && (
            <Hero heroTitle="Wonder Blog">
                <WonderBlogHeader />
            </Hero>
        )
    }
    {
        blogType === PROGRAMMING_BLOG_TYPE && (
            <Hero heroTitle="Programming Blog">
                <ProgrammingBlogHeader />
            </Hero>
        )
    }
    {!blogType && <h1 class="sr-only">{title}</h1>}
    <section class="container-page container-wide">
        {
            tags.length > 0 && (
                <div class="flex justify-center">
                    <TagList tags={tags} />
                </div>
            )
        }
        <BlogGrid posts={page.data} />
        {
            paginationRepository.showPagination && (
                <div class="mt-10">
                    <Pagination pageData={paginationRepository} />
                </div>
            )
        }
    </section>
</MainLayout>
