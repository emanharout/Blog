---
import type { CollectionEntry } from 'astro:content';
import TagList from '../../components/TagList.astro';
import BlogGrid from '../../components/BlogGrid.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { toTitleCase, getAllPostsSorted, getUniqueTags, slugifyTag } from '../../scripts/utilities.ts';

export const getStaticPaths = async () => {
    const posts = await getAllPostsSorted();
    const tags = getUniqueTags(posts);

    const tagPaths = tags.map((tag) => ({
        params: { tag_slug: slugifyTag(tag) as string | undefined },
        props: {
            tag: tag as string | undefined,
            posts: posts.filter((post) => post.data.tags.includes(tag)),
        },
    }));

    // `undefined` matches mysite.com/tags, which lists every topic and every post.
    const allTagsPath = {
        params: { tag_slug: undefined },
        props: { tag: undefined, posts },
    };

    return [...tagPaths, allTagsPath];
};

type Props = {
    // `undefined` when showing all tags.
    tag: string | undefined;
    posts: CollectionEntry<'posts'>[];
};

const { tag, posts } = Astro.props;
const tagTitle = tag ? toTitleCase(tag) : undefined;
const title = tagTitle ? `Posts on ${tagTitle}` : 'Topics';
const description = tagTitle ? `Explore posts on ${tagTitle}.` : 'Explore posts via topics.';
const allTags = getUniqueTags(await getAllPostsSorted());
---

<MainLayout title={title} description={description}>
    <section class="container-page container-wide">
        {
            tagTitle ? (
                <h1 class="text-center text-fg-1 py-8 font-semibold font-serif text-2xl">{tagTitle}</h1>
            ) : (
                <div class="flex justify-center">
                    <h1 class="sr-only">Topics</h1>
                    <TagList tags={allTags} />
                </div>
            )
        }
        <BlogGrid posts={posts} />
    </section>
</MainLayout>
