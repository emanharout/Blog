---
import BlogGrid from '../components/BlogGrid.astro';
import HomeHeader from '../components/HomeHeader.astro';
import Hero from '../layouts/Hero.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '../scripts/constants';
import { getAllPostsSorted } from '../scripts/utilities';

const blogPosts = await getAllPostsSorted();
---

<MainLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
    <Hero heroTitle="Hello, my name is Eman!">
        <HomeHeader />
    </Hero>
    <section class="container-page container-wide">
        <h2 class="sr-only">Latest posts</h2>
        <BlogGrid posts={blogPosts} />
    </section>
</MainLayout>
