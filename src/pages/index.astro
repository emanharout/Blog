---
import BlogGrid from '../components/BlogGrid.astro';
import HomeHeader from '../components/HomeHeader.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { PROGRAMMING_BLOG_TYPE, SITE_DESCRIPTION, SITE_NAME, WONDER_BLOG_TYPE } from '../scripts/constants';
import { getAllPostsSorted } from '../scripts/utilities';

const LATEST_POST_COUNT = 6;
const latestPosts = (await getAllPostsSorted()).slice(0, LATEST_POST_COUNT);

// Orb colors follow the theme roles, so they shift from day (green / sky blue) to night (dusk / starlit blue).
const blogs = [
    {
        href: `/blog/${WONDER_BLOG_TYPE}`,
        title: 'Wonder Blog',
        blurb: 'The paradoxes and possibilities of life, the harmony between art and science, and the everyday magic hidden in the ordinary.',
        orbClass: '[--orb-from:var(--color-secondary-300)] [--orb-to:var(--color-secondary-600)]',
        icon: 'sparkle',
    },
    {
        href: `/blog/${PROGRAMMING_BLOG_TYPE}`,
        title: 'Programming Blog',
        blurb: 'iOS and Swift take center stage, with JavaScript and the modern web alongside. Above all, best practices that hold up in any language.',
        orbClass: '[--orb-from:var(--color-primary-300)] [--orb-to:var(--color-primary-600)]',
        icon: 'code',
    },
] as const;
---

<MainLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
    <section class="container-page container-content pt-4 sm:pt-10">
        <div
            class="glass grid items-start gap-6 rounded-panel px-6 py-8 text-fg-2
            sm:px-12 sm:py-12
            md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12"
        >
            <h1 class="font-serif text-4xl leading-tight text-balance text-fg-1 sm:text-5xl md:text-right">
                Hello, my name is
                <span class="text-accent">Eman</span>!
            </h1>
            <div class="max-w-prose space-y-4 text-pretty sm:pl-4 md:pl-0">
                <HomeHeader />
            </div>
        </div>
    </section>

    <section class="container-page container-content mt-6 sm:mt-8" aria-label="Blogs">
        <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6">
            {
                blogs.map(({ href, title, blurb, orbClass, icon }) => (
                    <li>
                        <a
                            href={href}
                            class="glass group flex h-full gap-4 rounded-box p-5 sm:p-6
                            transition duration-300 hover:-translate-y-0.5
                            focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-500
                            motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                        >
                            <span class:list={['orb size-12 shrink-0', orbClass]} aria-hidden="true">
                                {icon === 'sparkle' ? (
                                    <svg viewBox="0 0 24 24" class="relative size-6" fill="currentColor">
                                        <path d="M12 2.5c.4 4.6 2.4 6.9 7 7.5-4.6.6-6.6 2.9-7 7.5-.4-4.6-2.4-6.9-7-7.5 4.6-.6 6.6-2.9 7-7.5Z" />
                                        <path d="M19 15.5c.2 1.9 1 2.8 2.9 3-1.9.2-2.7 1.1-2.9 3-.2-1.9-1-2.8-2.9-3 1.9-.2 2.7-1.1 2.9-3Z" opacity=".8" />
                                    </svg>
                                ) : (
                                    <svg viewBox="0 0 24 24" class="relative size-6" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4.5l-3 15" />
                                    </svg>
                                )}
                            </span>
                            <div class="flex flex-col">
                                <h2 class="font-serif text-2xl text-fg-1">{title}</h2>
                                <span class="mt-1 text-sm leading-relaxed text-fg-2">{blurb}</span>
                                <span
                                    class="mt-3 inline-flex items-center gap-1 text-sm font-medium
                                    text-primary-700 dark:text-primary-300"
                                >
                                    Explore
                                    <span
                                        class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
                                        aria-hidden="true">→</span
                                    >
                                </span>
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="container-page container-content mt-12 sm:mt-16">
        <div class="mb-5 flex items-baseline justify-between gap-4">
            <h2 class="font-serif text-2xl text-fg-1 sm:text-3xl">Latest posts</h2>
            <a
                href="/blog"
                class="rounded-pill px-3 py-1 text-sm font-medium text-primary-700 hover:bg-bg-2 dark:text-primary-300"
            >
                All posts <span aria-hidden="true">→</span>
            </a>
        </div>
        <BlogGrid posts={latestPosts} />
    </section>
</MainLayout>
