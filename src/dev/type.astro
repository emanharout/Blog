---
// Dev-only page (registered in astro.config.mjs only for `astro dev`): a sample post with every heading level from h2
// to h6, laid out like BlogArticle.astro, to try the type scale. The font picker at the bottom (FontPicker.astro, on
// every page in dev) swaps the heading and body fonts, and keeps the choice as you browse the rest of the site.
// /dev/sample-post has a more realistic post.
import MainLayout from '../layouts/MainLayout.astro';
import DevArticle from './DevArticle.astro';
import { Content as Sample, getHeadings } from './typeSample.md';
---

<MainLayout title="Type preview" description="Heading levels and font pairings" shootingStars={false}>
    <DevArticle title="A Field Guide to Swift Concurrency" headings={getHeadings()}>
        <Sample />
    </DevArticle>
</MainLayout>
