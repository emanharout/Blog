---
// Dev-only page (registered in astro.config.mjs only for `astro dev`): a sample post with every heading level from h2
// to h6, laid out like BlogArticle.astro, to try the type scale. The panel at the bottom swaps the serif (headings,
// wordmark, quotes) and sans (body, UI) fonts across the whole page, to mix and match. An option marked "(site)" is what
// the site ships with; the others load from Google Fonts on this page only. The choice is kept in ?serif=&sans= so a
// reload or a shared link keeps it.
import TableOfContents from '../components/TableOfContents.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { Content as Sample, getHeadings } from './typeSample.md';

const headings = getHeadings();

interface FontOption {
    id: string;
    label: string;
    /** Google Fonts family; none for the site's own font */
    family?: string;
    /** Google Fonts axis spec: only weights and styles the family has, or Google rejects the request */
    axes?: string;
    vibe: string;
}

// The shortlist the site's pairing was chosen from. Source Serif 4 loads with its optical-size axis, as Newsreader does.
const SERIFS: FontOption[] = [
    {
        id: 'site',
        label: 'Newsreader (site)',
        vibe: 'Made for long-form reading on screens. Quiet confidence: linen shirts, the weekend paper at a café, a well-edited magazine essay.',
    },
    {
        id: 'source-serif',
        label: 'Source Serif 4',
        family: 'Source Serif 4',
        axes: 'ital,opsz,wght@0,8..60,300..700;1,8..60,300..700',
        vibe: 'A sober, bookish serif, and Source Sans’s sibling. Academic and trustworthy: a university press, a library reading room, tweed.',
    },
];

const SANSES: FontOption[] = [
    {
        id: 'site',
        label: 'Source Sans 3 (site)',
        vibe: 'Humanist, and Myriad’s open-source cousin, so it carries the Aero-era Apple and Adobe feel. Calm, friendly and unfussy.',
    },
    {
        id: 'hanken',
        label: 'Hanken Grotesk',
        family: 'Hanken Grotesk',
        vibe: 'A clean modern grotesque, a touch warmer than Inter. A Scandinavian design shop: pale wood, good lighting.',
    },
    {
        id: 'schibsted',
        label: 'Schibsted Grotesk',
        family: 'Schibsted Grotesk',
        vibe: 'Made for a Norwegian news group: compact, with some bite. A newsroom, an editorial desk, confident and direct.',
    },
];

const DEFAULT_AXES = 'ital,wght@0,400;0,500;0,600;0,700;1,400;1,600';
// One stylesheet per family, so one rejected request can't take the others down with it
const googleFontsUrls = [...SERIFS, ...SANSES]
    .filter((font) => font.family)
    .map(
        (font) =>
            `https://fonts.googleapis.com/css2?family=${font.family!.replaceAll(' ', '+')}` +
            `:${font.axes ?? DEFAULT_AXES}&display=swap`,
    );

const rows = [
    { kind: 'serif', title: 'Headings', fonts: SERIFS },
    { kind: 'sans', title: 'Body', fonts: SANSES },
];
---

<MainLayout title="Type preview" description="Heading levels and font pairings" shootingStars={false}>
    <!-- The layouts have no head slot; a stylesheet link in the body works the same -->
    {googleFontsUrls.map((href) => <link rel="stylesheet" href={href} />)}
    <TableOfContents headings={headings} variant="sheet" />
    <TableOfContents headings={headings} variant="strip" />
    <section
        class="grid grid-cols-[100%] justify-items-center items-start gap-x-3
        sm:px-4
        lg:grid-cols-[minmax(5ch,1fr)_auto_minmax(5ch,1fr)] lg:justify-items-start"
    >
        <div aria-hidden="true"></div>

        <div
            class="relative w-full max-w-post mt-4 mb-6 glass glass-reading sm:rounded-box
            [--article-pad:clamp(1.25rem,5vw,2rem)]"
        >
            <div class="px-(--article-pad) py-8">
                <article
                    data-long-notes="margin"
                    class="article-content
                    prose prose-fg2 max-w-none
                    prose-a:not-in-[sup]:text-fg-link-2
                    prose-a:not-in-[sup]:hover:text-fg-link-2-hover prose-a:not-in-[sup]:focus:text-fg-link-2-hover prose-a:in-[sup]:text-fg-footnote-2
                    prose-blockquote:text-2xl prose-blockquote:font-serif
                    prose-blockquote:text-tertiary-950 dark:prose-blockquote:text-fg-2
                    prose-blockquote:font-light prose-blockquote:italic prose-blockquote:tracking-[.01em]
                    prose-blockquote:leading-snug prose-blockquote:border-s-0 prose-blockquote:pl-[3.25rem]"
                >
                    <h1>A Field Guide to Swift Concurrency</h1>
                    <TableOfContents headings={headings} variant="inline" />
                    <Sample />
                </article>
            </div>
        </div>

        <TableOfContents headings={headings} variant="sidebar" />
    </section>

    <details class="type-demo-panel" open>
        <summary>Fonts</summary>
        {
            rows.map((row) => (
                <div class="type-demo-row" role="group" aria-label={`${row.title} font`} data-kind={row.kind}>
                    <span class="type-demo-title">{row.title}</span>
                    {row.fonts.map((font) => (
                        <button type="button" data-font={font.id} data-family={font.family} data-vibe={font.vibe}>
                            {font.label}
                        </button>
                    ))}
                    <p class="type-demo-vibe" aria-live="polite" />
                </div>
            ))
        }
    </details>
</MainLayout>

<script src="../scripts/tippyTooltipSetup.js"></script>
<script src="../scripts/blockQuoteSvgScript.ts"></script>
<script src="../scripts/tableOfContents.ts"></script>
<script src="../scripts/footnoteNotes.ts"></script>

<style is:global>
    .type-demo-panel {
        position: fixed;
        inset-inline: 1rem;
        /* Clear of the design tuner's button and Astro's dev toolbar */
        bottom: 4rem;
        z-index: 50;
        width: fit-content;
        max-width: min(48rem, calc(100% - 2rem));
        margin-inline: auto;
        padding: 0.5rem 0.75rem;
        font-family: system-ui, sans-serif;
        font-size: 0.78rem;
        color: hsl(var(--fg-color-2));
        background: hsl(var(--background-color-2) / 0.92);
        border: 1px solid hsl(var(--fg-color-border-2) / 0.4);
        border-radius: 1rem;
        box-shadow: 0 4px 16px hsl(0 0% 0% / 0.12);
        backdrop-filter: blur(8px);
    }
    .type-demo-panel summary {
        cursor: pointer;
        font-weight: 600;
        color: hsl(var(--fg-color-1));
    }
    .type-demo-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.2rem;
        margin-top: 0.5rem;
    }
    .type-demo-title {
        width: 4.5rem;
        font-weight: 600;
    }
    .type-demo-row button {
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        cursor: pointer;
    }
    .type-demo-row button[aria-pressed='true'] {
        font-weight: 600;
        color: hsl(var(--fg-footnote-2));
        background: hsl(var(--footnote-bg));
    }
    .type-demo-vibe {
        flex-basis: 100%;
        margin: 0.15rem 0 0 4.7rem;
        font-style: italic;
        line-height: 1.4;
    }
    /* Room to scroll the last lines clear of the panel */
    .article-content {
        padding-bottom: 12rem;
    }
</style>

<script>
    const root = document.documentElement;
    const params = new URLSearchParams(location.search);
    const FALLBACKS: Record<string, string> = {
        serif: 'ui-serif, Georgia, serif',
        sans: 'ui-sans-serif, system-ui, sans-serif',
    };

    for (const row of document.querySelectorAll<HTMLElement>('.type-demo-row')) {
        const kind = row.dataset.kind!;
        const buttons = [...row.querySelectorAll<HTMLButtonElement>('button')];
        const vibe = row.querySelector<HTMLElement>('.type-demo-vibe')!;

        const choose = (id: string | null) => {
            const button = buttons.find((b) => b.dataset.font === id) ?? buttons[0];
            const family = button.dataset.family;
            // font-serif, font-sans, the page's default font and the post headings all read these variables
            if (family) root.style.setProperty(`--font-${kind}`, `'${family}', ${FALLBACKS[kind]}`);
            else root.style.removeProperty(`--font-${kind}`);
            buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
            vibe.textContent = button.dataset.vibe ?? '';
            params.set(kind, button.dataset.font!);
            history.replaceState(null, '', `?${params}`);
        };
        buttons.forEach((button) => button.addEventListener('click', () => choose(button.dataset.font!)));
        choose(params.get(kind));
    }
</script>
