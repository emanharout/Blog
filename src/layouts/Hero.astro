---
type Props = {
    heroTitle: string;
};

const { heroTitle } = Astro.props;
---

<!-- Full-bleed colored band. Stacks on mobile; title and copy sit side by side from `sm`. -->
<section class="bg-primary-700 text-fg-light mb-8">
    <div
        class="container-page container-content grid gap-4 py-8
        sm:grid-cols-2 sm:items-start sm:gap-8 sm:py-10"
    >
        <h1 class="font-serif text-4xl text-balance text-center sm:text-right sm:justify-self-end sm:max-w-[24rem]">
            {heroTitle}
        </h1>
        <div class="text-pretty space-y-4 max-w-prose">
            <slot />
        </div>
    </div>
</section>
