---
// Name to use when referencing in CSS: 'Frank Ruhl Libre Variable'
// Supports weights 300-900
import '@fontsource-variable/frank-ruhl-libre';
import frankRuhlLibreWoff2 from '@fontsource-variable/frank-ruhl-libre/files/frank-ruhl-libre-latin-wght-normal.woff2?url';

// Name to use when referencing in CSS: 'Inter Variable'
// Supports weights 100-900
import '@fontsource-variable/inter';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

// Necessary for Tailwind to access everything in this file. RootLayout is used
// everywhere so this provides the import pretty much globally.
import '../styles/input.css';
import '../styles/shiki.css';
import { SITE_NAME } from '../scripts/constants';

interface Props {
    title: string;
    description: string;
    // Path or URL of the social-card image. Relative paths are resolved against `site`.
    image?: string;
    imageAlt?: string;
    ogType?: 'website' | 'article';
}

const { title, description, image = '/favicon.png', imageAlt, ogType = 'website' } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Social crawlers require absolute image URLs.
const absoluteImageURL = new URL(image, Astro.site).toString();
const socialImageAlt = imageAlt ?? description;
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <link rel="preload" as="font" type="font/woff2" href={frankRuhlLibreWoff2} crossorigin="anonymous" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | All Posts`} href="/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | Programming Blog`} href="/blog/programming/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | Wonder Blog`} href="/blog/wonder/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={absoluteImageURL} />
        <meta property="og:image:alt" content={socialImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImageURL} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        <!-- Keep this inline/public script in <head> so theme class is applied before first paint. -->
        <!-- This avoids a flash of wrong theme; tradeoff is that this script is not Astro-processed. -->
        <script is:inline src="/scripts/colorThemeScript.js"></script>
    </head>
    <body class="flex flex-col h-full bg-bg-1">
        <slot />
    </body>
</html>
