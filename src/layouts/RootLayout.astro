---
// Fonts are configured in astro.config.mjs (`fonts`) and exposed as CSS variables.
import { Font } from 'astro:assets';

// Necessary for Tailwind to access everything in this file. RootLayout is used
// everywhere so this provides the import pretty much globally.
import '../styles/input.css';
import '../styles/shiki.css';
import { SITE_NAME } from '../scripts/constants';
import { DEFAULT_LIGHT_STYLE } from '../scripts/lightStyles';

interface Props {
    title: string;
    description: string;
    // Path or URL of the social-card image. Relative paths are resolved against `site`.
    image?: string;
    imageAlt?: string;
    ogType?: 'website' | 'article';
    // Opt-in page design. 'aero' swaps the theme roles for the glass / Frutiger Aero look (see src/styles/input.css).
    design?: 'aero';
}

const { title, description, image = '/favicon.png', imageAlt, ogType = 'website', design } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Social crawlers require absolute image URLs.
const absoluteImageURL = new URL(image, Astro.site).toString();
const socialImageAlt = imageAlt ?? description;
---

<!doctype html>
<html lang="en" class="h-full" data-design={design} data-light-style={design === 'aero' ? DEFAULT_LIGHT_STYLE : undefined}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <Font cssVariable="--font-libre-caslon" preload={[{ style: 'normal' }]} />
        <Font cssVariable="--font-source-sans-3" preload={[{ style: 'normal' }]} />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | All Posts`} href="/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | Programming Blog`} href="/blog/programming/rss.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} | Wonder Blog`} href="/blog/wonder/rss.xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={absoluteImageURL} />
        <meta property="og:image:alt" content={socialImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImageURL} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        {
            /*
              Dev only: preview another light-mode style (see src/scripts/lightStyles.ts) from ?light-style=… or the
              design tuner's choice, before first paint. 'default' is Refined Aero (no attribute). Production always
              uses DEFAULT_LIGHT_STYLE, set on <html> above.
            */
            import.meta.env.DEV && (
                <script is:inline>
                    (() => {
                        try {
                            const fromUrl = new URLSearchParams(location.search).get('light-style');
                            const style = fromUrl ?? localStorage.getItem('light-style');
                            if (style === 'default') delete document.documentElement.dataset.lightStyle;
                            else if (style) document.documentElement.dataset.lightStyle = style;
                        } catch {
                            // Storage unavailable; use the default style.
                        }
                    })();
                </script>
            )
        }
        {
            /* Dev only: the font picker's choice (src/components/FontPicker.astro), applied before first paint. */
            import.meta.env.DEV && (
                <script is:inline>
                    (() => {
                        try {
                            const { serif } = JSON.parse(localStorage.getItem('font-preview') ?? '{}');
                            for (const [kind, font] of Object.entries({ serif })) {
                                if (!font) continue;
                                const link = document.createElement('link');
                                link.rel = 'stylesheet';
                                link.href = font.href;
                                link.dataset.fontPreview = kind;
                                document.head.append(link);
                                document.documentElement.style.setProperty(`--font-${kind}`, font.stack);
                                // Undo Libre Caslon's adjustments in input.css, as FontPicker.astro does
                                document.documentElement.style.setProperty('--serif-size-adjust', 'none');
                                document.documentElement.style.setProperty('--serif-h2-weight', '600');
                            }
                        } catch {
                            // Storage unavailable or malformed; use the site's fonts.
                        }
                    })();
                </script>
            )
        }
        <!-- Keep this inline/public script in <head> so theme class is applied before first paint. -->
        <!-- This avoids a flash of wrong theme; tradeoff is that this script is not Astro-processed. -->
        <script is:inline src="/scripts/colorThemeScript.js"></script>
    </head>
    <body class="flex flex-col h-full bg-bg-1">
        <slot />
    </body>
</html>
