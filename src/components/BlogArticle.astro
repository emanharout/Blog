---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import TableOfContents from './TableOfContents.astro';

type Props = {
    post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const hasImage = Boolean(post.data.image && post.data.imageAlt);

const { Content, headings } = await render(post);
---

<!--
  Layout: a single centered card on small screens. At `lg` a three-column grid puts the card in the middle and the
  sticky table of contents on the right (the left column is an empty spacer that keeps the card centered).
-->
<section
    class="grid grid-cols-[100%] justify-items-center items-start gap-x-3
    sm:px-4
    lg:grid-cols-[minmax(5ch,1fr)_auto_minmax(5ch,1fr)] lg:justify-items-start"
>
    <div aria-hidden="true"></div>

    <!--
      `--article-pad` is the card's inner horizontal padding. Full-bleed children (images here, code blocks in
      shiki.css) use it as a negative margin to reach the card edges. Change it here and everything stays aligned.
    -->
    <div
        class="w-full max-w-[65ch] mb-6 bg-bg-2 shadow-md sm:rounded-xl overflow-hidden
        [--article-pad:clamp(1.25rem,5vw,2rem)]"
    >
        {
            hasImage && (
                <Picture
                    src={post.data.image!}
                    alt={post.data.imageAlt ?? ''}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    loading="eager"
                    fetchpriority="high"
                    widths={[480, 720, 1040]}
                    sizes="(min-width: 65ch) 65ch, 100vw"
                    class="w-full object-cover"
                />
            )
        }
        <div class="px-(--article-pad) py-8">
            <!--
              Blockquotes: the default left border is removed and left padding leaves room for the quotation-mark SVG
              added by blockQuoteSvgScript.ts. If this padding changes, adjust the SVG's position in that script.
            -->
            <article
                class="article-content
                prose prose-fg2 max-w-none
                prose-a:text-fg-primary-link-2
                hover:prose-a:text-fg-primary-link-2-hover focus:prose-a:text-fg-primary-link-2-hover
                prose-blockquote:text-2xl prose-blockquote:font-serif
                prose-blockquote:text-primary-950 dark:prose-blockquote:text-fg-2
                prose-blockquote:font-light prose-blockquote:italic prose-blockquote:tracking-[.01em]
                prose-blockquote:leading-snug prose-blockquote:border-s-0 prose-blockquote:pl-[3.25rem]
                prose-img:rounded-sm prose-img:max-w-none
                prose-img:mx-[calc(-1*var(--article-pad))] prose-img:w-[calc(100%+2*var(--article-pad))]
                prose-headings:font-serif prose-headings:tracking-wide prose-headings:font-medium"
            >
                <!-- The title comes from frontmatter; posts contain only body content. -->
                <h1>{post.data.title}</h1>
                <TableOfContents headings={headings} variant="inline" />
                <Content />
            </article>
        </div>
    </div>

    <TableOfContents headings={headings} variant="sidebar" />
</section>

<script src="../scripts/tippyTooltipSetup.js"></script>
<script src="../scripts/blockQuoteSvgScript.ts"></script>
<script src="../scripts/tableOfContents.ts"></script>
