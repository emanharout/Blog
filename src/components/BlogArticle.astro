---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import TableOfContents from './TableOfContents.astro';

type Props = {
    post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const hasImage = Boolean(post.data.image && post.data.imageAlt);

const { Content, headings } = await render(post);
---

<!--
  Layout: a single centered card on small screens. At `lg` a three-column grid puts the card in the middle and the
  sticky table of contents on the right (the left column is an empty spacer that keeps the card centered).
-->
<!--
  Collapses the sidebar table of contents before first paint, if the reader collapsed it on an earlier visit
  (tableOfContents.ts keeps the choice). Here, ahead of the inline ToC, which shows in its place from `xl` up.
-->
<script is:inline>
    try {
        if (localStorage.getItem('toc-collapsed') === 'true') document.documentElement.setAttribute('data-toc-collapsed', '');
    } catch {
        // Storage unavailable; the sidebar starts expanded.
    }
</script>
<TableOfContents headings={headings} variant="sheet" />
<TableOfContents headings={headings} variant="strip" />
<section
    class="grid grid-cols-[100%] justify-items-center items-start gap-x-3
    sm:px-4
    lg:grid-cols-[minmax(5ch,1fr)_auto_minmax(5ch,1fr)] lg:justify-items-start"
>
    <div aria-hidden="true"></div>

    <!--
      `--article-pad` is the card's inner horizontal padding. Full-bleed children (images, here) use it
      as a negative margin to reach the card edges. Change it here and everything stays aligned.
      The card doesn't clip its content, so footnotes can sit in the margin beside it (`.fn-note` in input.css); the
      image is rounded to the card's corners by its own wrapper.
    -->
    <div
        class="relative w-full max-w-post mt-4 mb-6 glass glass-reading sm:rounded-box
        [--article-pad:clamp(1.25rem,5vw,2rem)]"
    >
        {
            hasImage && (
                <div class="post-hero overflow-hidden rounded-t-[inherit]">
                    <Picture
                        src={post.data.image!}
                        alt={post.data.imageAlt ?? ''}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpg"
                        loading="eager"
                        fetchpriority="high"
                        widths={[480, 720, 1040]}
                        sizes="(min-width: 36rem) 36rem, 100vw"
                        class="w-full object-cover"
                    />
                </div>
            )
        }
        <div class="px-(--article-pad) py-8">
            <!--
              Blockquotes: the default left border is removed and left padding leaves room for the quotation-mark SVG
              added by blockQuoteSvgScript.ts. If this padding changes, adjust the SVG's position in that script.
            -->
            <!--
              data-long-notes: where long footnotes go on wide screens (footnoteNotes.ts). "inline": they stay closed in
              the text and open under their line; "margin": in the margin like short ones, pushing later notes down.
            -->
            <!--
              Links take the link color, and darken on their own hover or focus. Footnote numbers (in a <sup>) take the
              footnote text color instead; their tinted box comes from input.css.
            -->
            <article
                data-long-notes="margin"
                class="article-content
                prose prose-fg2 max-w-none
                prose-a:not-in-[sup]:text-fg-link-2
                prose-a:not-in-[sup]:hover:text-fg-link-2-hover prose-a:not-in-[sup]:focus:text-fg-link-2-hover prose-a:in-[sup]:text-fg-footnote-2
                prose-blockquote:text-2xl prose-blockquote:font-serif
                prose-blockquote:text-tertiary-950 dark:prose-blockquote:text-fg-2
                prose-blockquote:font-light prose-blockquote:italic prose-blockquote:tracking-[.01em]
                prose-blockquote:leading-snug prose-blockquote:border-s-0 prose-blockquote:pl-[3.25rem]
                prose-img:rounded-sm prose-img:max-w-none
                prose-img:mx-[calc(-1*var(--article-pad))] prose-img:w-[calc(100%+2*var(--article-pad))]"
            >
                <!-- The title comes from frontmatter; posts contain only body content. -->
                <h1>{post.data.title}</h1>
                <TableOfContents headings={headings} variant="inline" />
                <Content />
            </article>
        </div>
    </div>

    <TableOfContents headings={headings} variant="sidebar" />
</section>

<script src="../scripts/tippyTooltipSetup.js"></script>
<script src="../scripts/blockQuoteSvgScript.ts"></script>
<script src="../scripts/tableOfContents.ts"></script>
<script src="../scripts/footnoteNotes.ts"></script>
