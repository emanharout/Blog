---
import { Icon } from 'astro-icon/components';

// `value` must match the options handled in public/scripts/colorThemeScript.js.
const options = [
    { value: 'light', label: 'Light', icon: 'color-theme-light-icon', iconClass: 'text-yellow-500 dark:text-yellow-400' },
    { value: 'dark', label: 'Dark', icon: 'color-theme-dark-icon', iconClass: 'text-sky-400 dark:text-sky-500' },
    { value: 'system', label: 'Match system', icon: 'color-theme-system-icon', iconClass: 'text-gray-temp-500 dark:text-gray-temp-400' },
];
---

<!--
    Aero pages: a glass pill with a raised glass bead under the selected option that slides between them. The room at
    both ends matches the room above and below, so the bead sits the same distance from every edge. Other pages keep
    the pressed-in gray cells.
-->
<fieldset
    class="theme-picker grid grid-cols-3 h-9 w-32 shrink-0 overflow-hidden
    text-sm shadow-md outline outline-1 outline-gray-temp-500/25 dark:outline-gray-temp-800
    rounded-lg bg-bg-2
    aero:glass aero:outline-0 aero:rounded-pill aero:px-(--bead-end-pad)"
>
    <legend class="sr-only">Color theme</legend>
    <span class="theme-bead" aria-hidden="true"></span>
    {
        options.map(({ value, label, icon, iconClass }) => (
            <label
                class="relative flex items-center justify-center h-full cursor-pointer
                transition duration-200 ease-in-out
                hover:bg-gray-temp-200 dark:hover:bg-gray-temp-600
                shadow-[inset_0_-1px_0px_rgba(0,0,0,0.08)] dark:shadow-[inset_0_-1px_0px_rgba(0,0,0,0.125)]
                has-checked:bg-gray-temp-100 dark:has-checked:bg-gray-temp-800
                has-checked:shadow-[inset_0_1px_4px_rgba(0,0,0,0.2)] dark:has-checked:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3)]
                aero:z-1 aero:rounded-pill aero:shadow-none
                aero:hover:bg-transparent aero:has-checked:bg-transparent aero:has-checked:shadow-none
                has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-tertiary-500"
            >
                <input type="radio" name="theme" value={value} data-label={label} class="sr-only" />
                <Icon name={icon} size="22" aria-hidden="true" class={`theme-icon size-[22px] ${iconClass}`} />
                <span class="sr-only">{label}</span>
            </label>
        ))
    }
</fieldset>

<!-- Announces theme changes to screen readers -->
<div aria-live="polite" class="sr-only" id="theme-selection-feedback"></div>

<style>
    /*
     * The bead is tinted by the option it sits under: sunlight for Light, sky blue for Dark, soft gray for Match
     * system. Night uses lighter tints, since there the bead is a translucent glow rather than a pale fill.
     */
    /* Registered as a color so the tint can shift smoothly as the bead slides */
    @property --bead-tint {
        syntax: '<color>';
        inherits: true;
        initial-value: transparent;
    }

    .theme-picker {
        /* Matches the bead's 3px inset below it (and the 3px above it, before the nudge) */
        --bead-end-pad: 3px;
        /* How far the bead and icons sit below geometric center; the pill grows by the same amount */
        --bead-nudge: 1px;
        --bead-tint: hsl(45 95% 55%);
    }

    .theme-picker:has(input[value='dark']:checked) {
        --bead-tint: hsl(198 90% 58%);
    }

    .theme-picker:has(input[value='system']:checked) {
        --bead-tint: hsl(220 10% 60%);
    }

    :global(.dark) .theme-picker {
        --bead-tint: hsl(45 90% 62%);
    }

    :global(.dark) .theme-picker:has(input[value='dark']:checked) {
        --bead-tint: hsl(205 85% 66%);
    }

    :global(.dark) .theme-picker:has(input[value='system']:checked) {
        --bead-tint: hsl(220 12% 72%);
    }

    /*
     * A theme switch cross-fades the page from a snapshot (see colorThemeScript.js), which would hide the bead's slide
     * behind a fading copy of the old picker. Naming the picker gives it its own layer in that transition; showing
     * only the live picker in that layer lets the bead slide while the rest of the page fades.
     */
    :global([data-design='aero']) .theme-picker {
        view-transition-name: theme-picker;
    }

    :global(html.theme-switching::view-transition-old(theme-picker)) {
        display: none;
    }

    :global(html.theme-switching::view-transition-new(theme-picker)) {
        animation: none;
    }

    .theme-bead {
        display: none;
    }

    /* The nudge: extra height, added as padding above the icons so they move down with the bead */
    :global([data-design='aero']) .theme-picker {
        height: calc(2.25rem + var(--bead-nudge));
        padding-top: var(--bead-nudge);
    }

    :global([data-design='aero']) .theme-bead {
        display: block;
        position: absolute;
        /* Optically centered: the glass shine along the top hides some of the gap above, and the bead's shadow
           darkens the gap below, so the bead (and the icons with it) sits --bead-nudge lower, in a pill that is
           --bead-nudge taller to keep room beneath it */
        top: calc(3px + var(--bead-nudge));
        bottom: 3px;
        left: var(--bead-end-pad);
        width: calc((100% - 2 * var(--bead-end-pad)) / 3);
        border-radius: 9999px;
        pointer-events: none;
        background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 14%, rgb(255 255 255 / 0.95)),
            color-mix(in oklab, var(--bead-tint) 26%, rgb(255 255 255 / 0.7))
        );
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 1),
            0 1px 2px hsl(var(--glass-shadow-color) / 0.14),
            0 3px 8px -2px hsl(var(--glass-shadow-color) / 0.28);
    }

    :global(.dark[data-design='aero']) .theme-bead {
        background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 30%, transparent),
            color-mix(in oklab, var(--bead-tint) 12%, transparent)
        );
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.2),
            0 2px 6px -1px rgb(0 0 0 / 0.5);
    }

    .theme-picker:has(input[value='dark']:checked) .theme-bead {
        transform: translateX(100%);
    }

    .theme-picker:has(input[value='system']:checked) .theme-bead {
        transform: translateX(200%);
    }

    /* Slide and retint only while the picker is in use, so the bead doesn't glide into place when a page loads */
    .theme-picker:is(:hover, :focus-within) {
        transition: --bead-tint 500ms;
    }

    .theme-picker:is(:hover, :focus-within) .theme-bead {
        transition: transform 500ms cubic-bezier(0.3, 1.4, 0.5, 1);
    }

    :global([data-design='aero'] .theme-icon) {
        transition: transform 200ms ease-out;
    }

    :global([data-design='aero']) label:not(:has(:checked)):hover :global(.theme-icon) {
        transform: scale(1.1);
    }

    @media (prefers-reduced-motion: reduce) {
        .theme-picker,
        .theme-picker .theme-bead,
        :global([data-design='aero'] .theme-icon) {
            transition: none;
        }
    }
</style>
