---
import { Icon } from 'astro-icon/components';

// `value` must match the options handled in public/scripts/colorThemeScript.js.
const options = [
    { value: 'light', label: 'Light', icon: 'color-theme-light-icon', iconClass: 'text-yellow-500 dark:text-yellow-400' },
    { value: 'dark', label: 'Dark', icon: 'color-theme-dark-icon', iconClass: 'text-sky-400 dark:text-sky-500' },
    { value: 'system', label: 'Match system', icon: 'color-theme-system-icon', iconClass: 'text-gray-temp-500 dark:text-gray-temp-400' },
];
---

<fieldset
    class="grid grid-cols-3 h-9 w-32 shrink-0 overflow-hidden
    text-sm shadow-md outline outline-1 outline-gray-temp-500/25 dark:outline-gray-temp-800
    rounded-lg bg-bg-2"
>
    <legend class="sr-only">Color theme</legend>
    {
        options.map(({ value, label, icon, iconClass }) => (
            <label
                class="relative flex items-center justify-center h-full cursor-pointer
                transition duration-200 ease-in-out
                hover:bg-gray-temp-200 dark:hover:bg-gray-temp-600
                shadow-[inset_0_-1px_0px_rgba(0,0,0,0.08)] dark:shadow-[inset_0_-1px_0px_rgba(0,0,0,0.125)]
                has-checked:bg-gray-temp-100 dark:has-checked:bg-gray-temp-800
                has-checked:shadow-[inset_0_1px_4px_rgba(0,0,0,0.2)] dark:has-checked:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3)]
                has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-primary-500"
            >
                <input type="radio" name="theme" value={value} data-label={label} class="sr-only" />
                <Icon name={icon} size="22" aria-hidden="true" class={`size-[22px] ${iconClass}`} />
                <span class="sr-only">{label}</span>
            </label>
        ))
    }
</fieldset>

<!-- Announces theme changes to screen readers -->
<div aria-live="polite" class="sr-only" id="theme-selection-feedback"></div>
