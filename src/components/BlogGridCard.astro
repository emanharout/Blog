---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../scripts/utilities';
import CardTagList from './CardTagList.astro';

type Props = {
    post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
---

<!--
  The title link's ::after covers the whole card so the card is clickable; tag links sit above it (z-10).
  `tilt-card` + data-tilt: the card tilts toward the pointer (see src/scripts/cardTilt.ts).
-->
<li
    data-tilt
    class="relative flex flex-col justify-between gap-4 min-h-44
    px-4 pt-3 pb-3
    rounded-lg shadow-md border border-fg-border-2
    bg-bg-2 text-fg-2
    aero:glass aero:rounded-card aero:px-5 aero:pt-4 aero:pb-4
    tilt-card"
>
    <article class="contents">
        <div>
            <h3 class="font-semibold leading-tight text-gray-temp-800 dark:text-gray-temp-200 aero:text-fg-1 aero:dark:text-fg-1 line-clamp-3">
                <a
                    href={`/blog/${post.id}`}
                    class="after:absolute after:inset-0 after:rounded-lg hover:text-primary-400
                    aero:after:rounded-card aero:hover:text-primary-700 aero:dark:hover:text-primary-300"
                >
                    {post.data.title}
                </a>
            </h3>
            <p class="mt-2 text-xs text-gray-temp-500 dark:text-gray-temp-300 aero:text-fg-2/80 aero:dark:text-fg-2/80">
                by {post.data.author} on <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </p>
            <p class="mt-3 text-sm line-clamp-3">{post.data.description}</p>
        </div>
        <CardTagList tags={post.data.tags} />
    </article>
</li>
