---
import { Icon } from 'astro-icon/components';
import ColorThemeToggle from './ColorThemeToggle.astro';
import NavItem from './NavItem.astro';
import { PROGRAMMING_BLOG_TYPE, WONDER_BLOG_TYPE } from '../scripts/constants';

// Without the trailing slash the built site is served with, so `/blog/wonder/` matches `/blog/wonder`
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isHome = path === '/';
const isBlog = path.startsWith('/blog') || path.startsWith('/tags');
const isAbout = path.startsWith('/about');
const isSearch = path.startsWith('/search');

const blogLinks = [
    // `short` is the chip label in the mobile menu, where the full names don't fit on one line
    { href: `/blog/${WONDER_BLOG_TYPE}`, label: 'Wonder Blog', short: 'Wonder' },
    { href: `/blog/${PROGRAMMING_BLOG_TYPE}`, label: 'Programming Blog', short: 'Programming' },
    { href: '/blog', label: 'All Posts', short: 'All posts' },
];

const linkClasses = 'block px-4 py-2.5 md:px-3 md:py-2';
---

<!--
  Below `md` this panel is a floating glass card under the header, hidden until the menu button in SiteHeader opens it
  (data-open); it grows out of the button's corner. At `md` and up it is always visible as a horizontal nav bar.
-->
<nav
    id="site-nav-panel"
    aria-label="Main"
    class="hidden data-open:block
    max-md:absolute! max-md:top-full max-md:right-[calc(var(--spacing-outer-edge)-0.25rem)]
    max-md:w-max max-md:max-w-[calc(100%-2*var(--spacing-outer-edge)+0.5rem)] max-md:mt-2 max-md:p-2 max-md:glass max-md:rounded-panel
    md:relative md:block md:basis-auto"
>
    <!-- Desktop only: the glass bead that rests under the active item and slides to the hovered one (script below) -->
    <span class="nav-bead" aria-hidden="true"></span>
    <ul class="nav-list flex flex-col md:flex-row md:items-center md:gap-3 md:py-6">
        <NavItem active={isHome}>
            <a href="/" class={linkClasses} aria-current={isHome ? 'page' : undefined}>Home</a>
        </NavItem>

        <NavItem active={isBlog}>
            <div class="flex items-center">
                <a href="/blog" class={`${linkClasses} grow md:pr-1`} aria-current={path === '/blog' ? 'page' : undefined}>Blog</a>
                <!-- Desktop only: on mobile the sections are always shown as chips under Blog -->
                <button
                    id="blog-submenu-button"
                    type="button"
                    aria-expanded="false"
                    aria-controls="blog-submenu"
                    class="hidden md:block px-2 py-2 rounded"
                >
                    <span class="sr-only">Show blog sections</span>
                    <Icon
                        name="dropdown-menu-arrow"
                        size="10"
                        aria-hidden="true"
                        class="transition-transform [[aria-expanded=true]>&]:rotate-180"
                    />
                </button>
            </div>
            <!--
              Mobile: a row of chips, always shown. Desktop: a glass dropdown with its own bead, which rests on the current
              section and slides to the hovered row (script below). Only the row under the bead takes the primary color
              (data-bead), as in the nav bar.
            -->
            <ul
                id="blog-submenu"
                class="blog-submenu flex flex-wrap gap-x-1.5 gap-y-2 mx-3 mt-2 mb-2.5 md:mx-0 md:mb-0 text-[0.8125rem] text-fg-2
                md:hidden md:data-open:block md:gap-0 md:text-sm
                md:absolute! md:left-0 md:top-full md:z-20 md:mt-2 md:w-52 md:p-1.5 md:space-y-0.5
                md:glass md:rounded-box"
            >
                <li class="nav-bead" aria-hidden="true"></li>
                {
                    blogLinks.map(({ href, label, short }) => {
                        // A section stays current on its later pages (/blog/wonder/2, and /blog/2 for All Posts)
                        const current = path === href || new RegExp(`^${href}/\\d+$`).test(path);
                        return (
                            <li
                                class="submenu-item relative md:transition-colors md:duration-200 motion-reduce:transition-none
                                md:data-bead:text-primary-700 md:dark:data-bead:text-primary-300"
                                data-active={current || undefined}
                                data-bead={current || undefined}
                            >
                                <a
                                    href={href}
                                    aria-current={current ? 'page' : undefined}
                                    class="block rounded-pill px-3 py-1.5 md:px-4 md:py-2
                                    max-md:bg-bg-2/40 max-md:ring-1 max-md:ring-fg-border-2
                                    max-md:[[data-active]>&]:ring-0 max-md:[[data-active]>&]:text-primary-700
                                    max-md:dark:[[data-active]>&]:text-primary-300"
                                >
                                    <span class="md:hidden">{short}</span>
                                    <span class="max-md:hidden">{label}</span>
                                </a>
                            </li>
                        );
                    })
                }
            </ul>
        </NavItem>

        <NavItem active={isAbout}>
            <a href="/about" class={`${linkClasses} md:pr-3.5`} aria-current={isAbout ? 'page' : undefined}>About</a>
        </NavItem>

        <NavItem active={isSearch}>
            <a href="/search" class="flex items-center justify-between gap-3 px-4 py-2.5 md:px-3 md:py-2" aria-current={isSearch ? 'page' : undefined}>
                <span class="md:sr-only">Search</span>
                <Icon name="nav-search-icon" size="24" aria-hidden="true" class="max-md:hidden" />
            </a>
        </NavItem>

        <li
            class="theme-row flex items-center justify-between mt-1.5 px-4 pt-2.5 pb-1 border-t border-fg-border-2
            md:mt-0 md:p-0 md:border-0"
        >
            <span class="text-sm text-fg-2 md:hidden">Theme</span>
            <ColorThemeToggle />
        </li>
    </ul>
</nav>

<style>
    /*
     * The bead look: tinted glass built like the theme picker's bead (ColorThemeToggle.astro), in the primary color.
     * Desktop slides it as .nav-bead (one in the nav bar, one in the Blog dropdown); mobile puts it straight on the
     * current row and section chip.
     */
    #site-nav-panel {
        --bead-tint: hsl(var(--primary-color-500));
        --bead-background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 14%, rgb(255 255 255 / 0.95)),
            color-mix(in oklab, var(--bead-tint) 26%, rgb(255 255 255 / 0.7))
        );
        --bead-shadow:
            inset 0 1px 0 rgb(255 255 255 / 1),
            0 1px 2px hsl(var(--glass-shadow-color) / 0.14),
            0 3px 8px -2px hsl(var(--glass-shadow-color) / 0.28);
    }

    :global(.dark) #site-nav-panel {
        --bead-tint: hsl(var(--primary-color-300));
        --bead-background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 30%, transparent),
            color-mix(in oklab, var(--bead-tint) 12%, transparent)
        );
        --bead-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.2),
            0 2px 6px -1px rgb(0 0 0 / 0.5);
    }

    .nav-bead {
        display: none;
    }

    @media (width < 48rem) {
        /* The current row (for Blog, the row itself, not the chips under it) and section chip wear the bead */
        #site-nav-panel :global(.nav-item > :first-child),
        .submenu-item > a {
            border-radius: 9999px;
        }

        #site-nav-panel :global(.nav-item[data-active] > :first-child),
        .submenu-item[data-active] > a {
            background: var(--bead-background);
            box-shadow: var(--bead-shadow);
        }

        /*
         * Hover moves the bead, as on desktop: the hovered row or chip takes it (and the primary color), and the current
         * one goes plain until the pointer leaves. Pointer devices only, so a tap on a phone doesn't leave it stuck.
         */
        @media (hover: hover) {
            #site-nav-panel :global(.nav-item:not([data-active]) > :first-child:hover),
            .submenu-item:not([data-active]) > a:hover {
                background: var(--bead-background);
                box-shadow: var(--bead-shadow);
                color: hsl(var(--primary-color-700));
            }

            /*
             * The pointer is over the list (gaps included, so moving between rows doesn't flash the current one back)
             * but not over the current item, Blog's chips included, or the Theme row: the current row goes plain.
             */
            #site-nav-panel:has(.nav-list:hover):not(
                    :has(.theme-row:hover, :global(.nav-item[data-active]:hover))
                ) {
                & :global(.nav-item[data-active] > :first-child) {
                    background: none;
                    box-shadow: none;
                }

                & :global(.nav-item[data-active]) {
                    color: hsl(var(--fg-color-1));
                }
            }

            /*
             * The current section chip (e.g. Wonder) turns back into an ordinary chip when the current row goes plain, or
             * while the pointer is among the other chips. The space above and below the chips is margin, not part of
             * the chip list, so moving from the Blog row down to Wonder never counts as being among the other chips.
             */
            #site-nav-panel:has(.nav-list:hover):not(:has(.theme-row:hover, :global(.nav-item[data-active]:hover)))
                .submenu-item[data-active]
                > a,
            .blog-submenu:hover:not(:has(.submenu-item[data-active]:hover)) .submenu-item[data-active] > a {
                background: color-mix(in oklab, var(--color-bg-2) 40%, transparent);
                box-shadow: 0 0 0 1px var(--color-fg-border-2);
                color: hsl(var(--fg-color-2));
            }

            :global(.dark) #site-nav-panel :global(.nav-item:not([data-active]) > :first-child:hover),
            :global(.dark) .submenu-item:not([data-active]) > a:hover {
                color: hsl(var(--primary-color-300));
            }
        }

        /*
         * The card grows out of the menu button's corner as it opens, and shrinks back into it as it closes
         * (allow-discrete keeps it displayed until the closing transition ends). Closing (the rule without data-open)
         * starts gently and fades only near the end, so the shrink stays visible; opening pops out with a slight overshoot.
         */
        #site-nav-panel {
            opacity: 0;
            clip-path: inset(0 0 100% calc(100% - 3rem) round var(--panel-radius));
            transition:
                opacity calc(var(--menu-duration) * 0.65) ease-in calc(var(--menu-duration) * 0.35),
                clip-path var(--menu-duration) cubic-bezier(0.45, 0, 0.25, 1),
                display var(--menu-duration) allow-discrete;
        }

        #site-nav-panel[data-open] {
            opacity: 1;
            clip-path: inset(0 round var(--panel-radius));
            transition:
                opacity calc(var(--menu-duration) * 0.6) ease-out,
                clip-path var(--menu-duration) cubic-bezier(0.35, 0.9, 0.4, 1.04),
                display var(--menu-duration) allow-discrete;
        }

        @starting-style {
            #site-nav-panel[data-open] {
                opacity: 0;
                clip-path: inset(0 0 100% calc(100% - 3rem) round var(--panel-radius));
            }
        }
    }

    @media (width >= 48rem) {
        /*
         * The nav bar is a glass pill, like the theme picker (ColorThemeToggle.astro), which sits at its end and drops its
         * own pill to share this one. The glass is drawn on a layer behind the items (::after) rather than on the nav
         * itself: a blurring nav would keep the Blog dropdown, which sits inside it, from blurring the page beneath.
         */
        #site-nav-panel {
            margin-block: 1.25rem;
            padding-inline: 0.25rem;
            border-radius: 9999px;
            /* Keeps the pill's layer behind the items rather than behind the page */
            isolation: isolate;

            &::after {
                content: '';
                position: absolute;
                inset: 0;
                z-index: -1;
                border: 1px solid var(--glass-border);
                border-radius: inherit;
                pointer-events: none;
                background: linear-gradient(
                    180deg,
                    hsl(var(--glass-tint-top) / var(--glass-opacity)),
                    hsl(var(--glass-tint-bottom) / calc(var(--glass-opacity) * var(--glass-fade)))
                );
                box-shadow:
                    inset 0 1px 0 hsl(0 0% 100% / calc(var(--glass-highlight-alpha) * var(--glass-intensity))),
                    0 1px 2px hsl(var(--glass-shadow-color) / calc(var(--glass-contact-alpha) * var(--glass-shadow-depth))),
                    0 calc(var(--glass-shadow-y) * var(--glass-shadow-depth))
                        calc(var(--glass-shadow-blur) * var(--glass-shadow-depth)) var(--glass-shadow-spread)
                        hsl(var(--glass-shadow-color) / calc(var(--glass-shadow-alpha) * var(--glass-shadow-depth)));
                -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-boost));
                backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-boost));
            }

            & .nav-list {
                padding-block: 0.25rem;
            }

            & :global(.theme-picker) {
                background: none;
                border-color: transparent;
                box-shadow: none;
                -webkit-backdrop-filter: none;
                backdrop-filter: none;
            }

            & :global(.theme-picker)::before {
                content: none;
            }
        }

        .nav-bead {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            border-radius: 9999px;
            pointer-events: none;
            opacity: 0;
            background: var(--bead-background);
            box-shadow: var(--bead-shadow);
        }

        /*
         * Like the mobile card, the dropdown unfolds out of its top-left corner (under Blog) as it opens and folds back
         * into it as it closes (the rule without data-open; allow-discrete keeps it displayed until that finishes).
         * Fully open, the clip reaches 3rem past the edges so the glass's floating shadow isn't cut off.
         */
        .blog-submenu {
            opacity: 0;
            clip-path: inset(0 calc(100% - 3rem) 100% 0 round var(--box-radius));
            transition:
                opacity calc(var(--menu-duration) * 0.65) ease-in calc(var(--menu-duration) * 0.35),
                clip-path var(--menu-duration) cubic-bezier(0.45, 0, 0.25, 1),
                display var(--menu-duration) allow-discrete;
        }

        .blog-submenu[data-open] {
            opacity: 1;
            clip-path: inset(-3rem round calc(var(--box-radius) + 3rem));
            transition:
                opacity calc(var(--menu-duration) * 0.6) ease-out,
                clip-path var(--menu-duration) cubic-bezier(0.35, 0.9, 0.4, 1.04),
                display var(--menu-duration) allow-discrete;
        }

        @starting-style {
            .blog-submenu[data-open] {
                opacity: 0;
                clip-path: inset(0 calc(100% - 3rem) 100% 0 round var(--box-radius));
            }
        }

        .nav-bead[data-shown] {
            opacity: 1;
        }

        /*
         * Until the script has placed the bead, the current item wears the bead's look itself, so a new page doesn't
         * show for a moment with no bead. The script puts the bead in exactly that spot, so the handover is invisible.
         */
        #site-nav-panel:not(:has(> .nav-bead[data-shown])) :global(.nav-item[data-active]) {
            background: var(--bead-background);
            box-shadow: var(--bead-shadow);
        }

        /* Set by the script after the first placement, so the bead doesn't glide into place when a page loads */
        .nav-bead[data-animated] {
            transition:
                transform 500ms cubic-bezier(0.3, 1.4, 0.5, 1),
                width 500ms cubic-bezier(0.3, 1.4, 0.5, 1),
                opacity 200ms ease-out;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-bead[data-animated] {
            transition: opacity 200ms ease-out;
        }

        .blog-submenu,
        .blog-submenu[data-open] {
            clip-path: none !important;
            transition:
                opacity calc(var(--menu-duration) * 0.6) ease-out,
                display calc(var(--menu-duration) * 0.6) allow-discrete;
        }

        #site-nav-panel {
            clip-path: none !important;
            transition:
                opacity calc(var(--menu-duration) * 0.6) ease-out,
                display calc(var(--menu-duration) * 0.6) allow-discrete;
        }
    }

    /*
     * Page changes made from the open mobile card are drawn from snapshots (see navigationDropdownMenu.ts), which
     * leave backdrop-filter blur out, so the card would turn see-through and show the text behind it. Instead the card
     * gets its own layer, and that layer does the frosting: its box blurs the page beneath it, the way the live card
     * blurs the live page. (Safari turns off backdrop-filter for the whole transition, so this helps only elsewhere.
     * Theme switches from the open card skip the fade for that reason; see colorThemeScript.js.)
     */
    @media (width < 48rem) {
        #site-nav-panel[data-open] {
            view-transition-name: nav-panel;
        }
    }

    :global(::view-transition-group(nav-panel)) {
        border-radius: var(--panel-radius);
        -webkit-backdrop-filter: blur(var(--glass-blur))
            saturate(calc(100% + (var(--glass-boost) - 100%) * var(--glass-intensity)));
        backdrop-filter: blur(var(--glass-blur)) saturate(calc(100% + (var(--glass-boost) - 100%) * var(--glass-intensity)));
    }

    /*
     * Leaving the page from the open card: the new page fades in while the card folds back into the menu button, the
     * same way it closes (#site-nav-panel above). The layer folds rather than the snapshot alone, so the blur folds
     * away with it. 450ms is --menu-duration, which is set on the header and so can't reach these layers.
     */
    :global(html:not(.theme-switching)::view-transition-group(nav-panel)) {
        animation: nav-panel-fold-away 450ms cubic-bezier(0.45, 0, 0.25, 1) both;
    }

    :global(html:not(.theme-switching)::view-transition-old(nav-panel)) {
        animation: none;
    }

    @keyframes nav-panel-fold-away {
        from {
            clip-path: inset(0 round var(--panel-radius));
        }
        35% {
            opacity: 1;
        }
        to {
            opacity: 0;
            clip-path: inset(0 0 100% calc(100% - 3rem) round var(--panel-radius));
        }
    }
</style>

<script>
    /**
     * Slides a bead under the hovered or keyboard-focused item of `container`, and back to the active item (or out of
     * sight, when none is active) once the pointer and focus leave. The item under the bead gets `data-bead`, which
     * the markup uses to give only that item the primary color.
     */
    function setupBead(container: HTMLElement, bead: HTMLElement, items: HTMLElement[]) {
        const activeItem = items.find((item) => item.hasAttribute('data-active'));
        let target: HTMLElement | undefined = activeItem;

        const place = () => {
            for (const item of items) item.toggleAttribute('data-bead', item === target);
            if (!target) {
                delete bead.dataset.shown;
                return;
            }
            // Layout offsets (relative to the container, which is the items' offset parent) rather than screen boxes, so
            // the dropdown's scale-in animation doesn't distort the measurement
            bead.style.transform = `translate(${target.offsetLeft}px, ${target.offsetTop}px)`;
            bead.style.width = `${target.offsetWidth}px`;
            bead.style.height = `${target.offsetHeight}px`;
            bead.dataset.shown = '';
        };

        // Place without the slide: on page load, when the container appears or resizes, and when the bead has to
        // appear from nowhere (so it doesn't glide in from the corner)
        const placeInstantly = () => {
            delete bead.dataset.animated;
            place();
            bead.getBoundingClientRect();
            bead.dataset.animated = '';
        };

        const moveTo = (item: HTMLElement | undefined) => {
            const appearing = !bead.hasAttribute('data-shown');
            target = item;
            if (appearing) placeInstantly();
            else place();
        };

        placeInstantly();

        // A finger lifting off the screen also counts as the pointer leaving, which would send the bead back to the
        // active item while the tapped link's page loads. So a tap that lands on a link keeps the bead where it went.
        // A touch that turns into a scroll is cancelled rather than lifted, so the bead still goes back after it.
        let tappedLink = false;

        // Once a link is clicked, its page is on the way, so the bead stays on that item until the page changes, even
        // if the pointer moves off it (or onto another item) while the new page loads
        let leaving = false;
        const follow = (item: HTMLElement | undefined) => {
            if (!leaving) moveTo(item);
        };

        for (const item of items) {
            item.addEventListener('pointerenter', () => follow(item));
            item.addEventListener('click', (event) => {
                const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
                const opensHere =
                    event.button === 0 &&
                    !event.metaKey &&
                    !event.ctrlKey &&
                    !event.shiftKey &&
                    !event.altKey &&
                    (!link?.target || link.target === '_self') &&
                    !link?.hasAttribute('download');
                if (link && opensHere && !event.defaultPrevented) {
                    moveTo(item);
                    leaving = true;
                }
            });
            item.addEventListener('pointerup', (event) => {
                tappedLink = event.pointerType !== 'mouse' && !!(event.target as Element).closest('a[href]');
            });
            // Follow keyboard focus only; a mouse click also focuses, and the bead shouldn't stay behind after it
            item.addEventListener('focusin', (event) => {
                if ((event.target as HTMLElement).matches(':focus-visible')) follow(item);
            });
        }
        container.addEventListener('pointerleave', () => {
            if (tappedLink) {
                tappedLink = false;
                return;
            }
            if (!container.querySelector(':focus-visible')) follow(activeItem);
        });
        // Coming back to this page from the back-forward cache would otherwise show the bead on the tapped item
        window.addEventListener('pageshow', (event) => {
            if (!event.persisted) return;
            tappedLink = false;
            leaving = false;
            target = activeItem;
            placeInstantly();
        });
        container.addEventListener('focusout', (event) => {
            if (!container.contains(event.relatedTarget as Node | null)) follow(activeItem);
        });

        // Item sizes change as fonts load and at the md breakpoint, and the dropdown has no size until it opens
        new ResizeObserver(placeInstantly).observe(container);
    }

    const nav = document.getElementById('site-nav-panel');
    const navBead = nav?.querySelector<HTMLElement>(':scope > .nav-bead');
    if (nav && navBead) {
        setupBead(nav, navBead, [...nav.querySelectorAll<HTMLElement>(':scope > ul > .nav-item')]);
    }

    const submenu = document.getElementById('blog-submenu');
    const submenuBead = submenu?.querySelector<HTMLElement>(':scope > .nav-bead');
    if (submenu && submenuBead) {
        setupBead(submenu, submenuBead, [...submenu.querySelectorAll<HTMLElement>(':scope > .submenu-item')]);
    }

    /**
     * In the mobile card the bead is drawn on the current row and section chip (`data-active`), so a tap would leave it
     * on the page being left while the card folds away. A tap on a link hands `data-active` to the rows and chips of
     * the page it opens: the row holding the link, and the chip with the same address (Blog's own row opens All Posts).
     */
    if (nav) {
        const navItems = [...nav.querySelectorAll<HTMLElement>(':scope > ul > .nav-item')];
        const chips = [...nav.querySelectorAll<HTMLElement>('.submenu-item')];
        const markers = [...navItems, ...chips];
        const initial = new Map(markers.map((item) => [item, item.hasAttribute('data-active')]));
        const mobile = window.matchMedia('(width < 48rem)');

        nav.addEventListener('click', (event) => {
            const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
            if (!link || !mobile.matches || event.defaultPrevented) return;
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            for (const item of navItems) item.toggleAttribute('data-active', item.contains(link));
            for (const chip of chips) {
                chip.toggleAttribute('data-active', chip.querySelector('a')?.pathname === link.pathname);
            }
        });

        // Coming back to this page from the back-forward cache would otherwise show the bead on the tapped item
        window.addEventListener('pageshow', (event) => {
            if (!event.persisted) return;
            for (const [item, active] of initial) item.toggleAttribute('data-active', active);
        });
    }
</script>
