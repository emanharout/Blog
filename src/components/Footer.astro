---
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

// TEMPORARY: trying the tertiary color here instead of the accent (secondary) to see how it looks.
// Glyph-only icons (the accent color by day, soft ink by night), so the row reads as one quiet set on the glass rather than five brand badges.
const links = [
    { href: 'https://x.com/emanharout', label: 'Visit my X profile', icon: 'x-social-icon' },
    { href: 'https://medium.com/@emanharout', label: 'Visit my Medium page', icon: 'medium-social-icon' },
    { href: 'mailto:elfin.genies06@icloud.com', label: 'Email me', icon: 'email-icon' },
    { href: 'https://github.com/emanharout', label: 'Visit my GitHub page', icon: 'github-social-icon' },
    { href: 'https://linkedin.com/in/emanharout', label: 'Visit my LinkedIn', icon: 'linkedin-social-icon' },
];
---

<footer class="main-footer shrink-0 mt-12 px-outer-edge pt-4 pb-8 text-center text-fg-2 sm:mt-16 sm:pb-10">
    <ul class="glass mx-auto flex max-w-fit flex-wrap justify-center gap-1 rounded-pill p-1.5">
        {
            links.map(({ href, label, icon }) => {
                const external = href.startsWith('http');
                return (
                    <li>
                        <a
                            href={href}
                            aria-label={label}
                            target={external ? '_blank' : undefined}
                            rel={external ? 'noopener noreferrer' : undefined}
                            class="grid size-11 place-items-center rounded-pill text-tertiary-600 dark:text-tertiary-300
                            transition-colors duration-200 hover:bg-tertiary-500/12
                            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500
                            motion-reduce:transition-none"
                        >
                            <Icon name={icon} size="20" aria-hidden="true" />
                        </a>
                    </li>
                );
            })
        }
    </ul>
    <p class="mt-4 text-sm">Copyright © {currentYear} Eman Harout</p>
</footer>
