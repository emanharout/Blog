---
import type { MarkdownHeading } from 'astro';
import type { HeadingHierarchy } from './TableOfContentsHeading.astro';
import TableOfContentsHeading from './TableOfContentsHeading.astro';

type Props = {
    headings: MarkdownHeading[];
    // `sidebar`: sticky panel beside the article, `lg` and up.
    // `inline`: collapsible block at the top of the article, below `lg`.
    variant: 'sidebar' | 'inline';
};

const { headings, variant } = Astro.props;

// Nest h3s under their preceding h2; deeper headings are left out.
function createHeadingHierarchy(headings: MarkdownHeading[]) {
    const topLevelHeadings: HeadingHierarchy[] = [];

    headings
        .filter((heading) => heading.depth <= 3)
        .forEach((heading) => {
            const h = { ...heading, subheadings: [] };
            if (h.depth === 2) {
                topLevelHeadings.push(h);
            } else {
                topLevelHeadings.at(-1)?.subheadings.push(h);
            }
        });

    return topLevelHeadings;
}

const toc: HeadingHierarchy[] = createHeadingHierarchy(headings ?? []);
const hasToC = toc.length > 1;
const titleId = `table-of-contents-title-${variant}`;
---

{
    hasToC && variant === 'sidebar' && (
        <nav
            aria-labelledby={titleId}
            class="hidden lg:block sticky top-4
            w-full max-w-[30ch] mt-[1px] mr-3 py-2 px-4
            bg-bg-2 rounded-r-lg rounded-tl-lg shadow-md"
        >
            <h2
                id={titleId}
                class="mt-2 mb-3 text-center uppercase font-medium text-sm text-gray-temp-500 dark:text-gray-temp-300
                xl:text-[0.925rem] xl:tracking-[.025rem] xl:font-semibold"
            >
                Table of Contents
            </h2>
            <ul class="text-[0.925rem] font-normal xl:font-medium xl:tracking-[.002rem]">
                {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
            </ul>
        </nav>
    )
}
{
    hasToC && variant === 'inline' && (
        <details class="not-prose group lg:hidden my-6 rounded-lg border border-fg-border-2 bg-bg-1/40">
            <summary
                class="flex items-center justify-between cursor-pointer list-none px-4 py-3
                uppercase text-sm font-medium tracking-wide text-gray-temp-500 dark:text-gray-temp-300
                [&::-webkit-details-marker]:hidden"
            >
                <span id={titleId}>Table of Contents</span>
                <span aria-hidden="true" class="transition-transform group-open:rotate-180">▾</span>
            </summary>
            <nav aria-labelledby={titleId} class="px-4 pb-3">
                <ul class="text-[0.95rem]">
                    {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
                </ul>
            </nav>
        </details>
    )
}
