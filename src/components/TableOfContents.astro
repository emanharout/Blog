---
import type { MarkdownHeading } from 'astro';
import type { HeadingHierarchy } from './TableOfContentsHeading.astro';
import TableOfContentsHeading from './TableOfContentsHeading.astro';
import TableOfContentsSegments from './TableOfContentsSegments.astro';

type Props = {
    headings: MarkdownHeading[];
    // `sidebar`: sticky panel beside the article, `lg` and up.
    // `inline`: collapsible block at the top of the article, below `lg`.
    // `sheet`: floating button, below `sm`, once the inline block has scrolled away. Opens the list in a panel that
    // slides up from the bottom. Place it outside the article card, which would clip it.
    // `strip`: slim panel floating at the top of the window, from `sm` to `lg`, once the inline block has scrolled away.
    // As wide as the article's text. Names the current section (and its parent), shows one progress segment per section
    // and drops down the list. Also goes outside the card.
    variant: 'sidebar' | 'inline' | 'sheet' | 'strip';
};

const { headings, variant } = Astro.props;

// Nest h3s under their preceding h2; deeper headings are left out.
function createHeadingHierarchy(headings: MarkdownHeading[]) {
    const topLevelHeadings: HeadingHierarchy[] = [];

    headings
        .filter((heading) => heading.depth <= 3)
        .forEach((heading) => {
            const h = { ...heading, subheadings: [] };
            if (h.depth === 2) {
                topLevelHeadings.push(h);
            } else {
                topLevelHeadings.at(-1)?.subheadings.push(h);
            }
        });

    return topLevelHeadings;
}

const toc: HeadingHierarchy[] = createHeadingHierarchy(headings ?? []);
const hasToC = toc.length > 1;
// Every entry, in document order
const sections = toc.flatMap((heading) => [heading, ...heading.subheadings]);
// One faint bar beside all the sections on screen; tableOfContents.ts sizes it and sets `data-visible`. It lines up
// with the active entry's solid bar (TableOfContentsHeading.astro), which is drawn over it.
const onScreenBarClasses = [
    'absolute -left-2.5 border-l-2 border-accent/40',
    'opacity-0 data-visible:opacity-100 transition-[top,height,opacity] duration-150 motion-reduce:transition-none',
];
// Scrolled entries fade out under the title, over 0.75rem. Each list's top padding keeps its first entry's text and bar
// below the fade while it's scrolled to the top.
const topFadeClasses = '[mask-image:linear-gradient(to_bottom,transparent,black_0.75rem)]';
// The sidebar and phone list also fade out at the bottom, over the same height. Their bottom padding keeps the last
// entry clear of it once scrolled to the end.
const edgeFadeClasses =
    '[mask-image:linear-gradient(to_bottom,transparent,black_0.75rem,black_calc(100%-0.75rem),transparent)]';
const titleId = `table-of-contents-title-${variant}`;
// Brings back the sidebar from the inline ToC and the strip, which stand in for it from `xl` up while it's collapsed.
// Sits in their title bar, just left of the chevron (the bar's content is centered in its top 2.75rem).
const restoreButtonClasses =
    'absolute top-1 right-11 z-10 hidden xl:toc-collapsed:grid size-9 place-items-center rounded-full cursor-pointer ' +
    'text-gray-temp-500 hover:text-gray-temp-700 dark:text-gray-temp-300 dark:hover:text-gray-temp-100 ' +
    'focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-tertiary-500';
---

{
    // Clicking its title collapses it (tableOfContents.ts): to a round button in the same place, from `lg` to `xl`, and
    // to the inline ToC in the post (and the strip, once that's scrolled away) from `xl` up, where it's hidden.
    hasToC && variant === 'sidebar' && (
        <nav
            data-toc-sidebar
            aria-labelledby={titleId}
            class="hidden lg:flex xl:toc-collapsed:hidden flex-col sticky top-4 max-h-[min(32rem,70dvh)]
            w-full max-w-[34ch] mt-[calc(1rem+2px)] mr-3 pt-2
            glass rounded-card
            toc-collapsed:size-11 toc-collapsed:p-0 toc-collapsed:rounded-[1.375rem]"
        >
            <h5
                id={titleId}
                class="shrink-0 px-2 font-serif font-medium text-base xl:text-lg toc-collapsed:hidden"
            >
                <button
                    type="button"
                    data-toc-collapse
                    aria-expanded="true"
                    aria-controls="table-of-contents-sidebar-list"
                    class="group/collapse block w-full px-1 py-0.5 rounded-md text-center cursor-pointer
                    text-gray-temp-500 hover:text-gray-temp-700 dark:text-gray-temp-300 dark:hover:text-gray-temp-100
                    focus-visible:outline-2 focus-visible:outline-tertiary-500"
                >
                    <!-- The chevron hangs off the end of the title, so that the title alone is centered. -->
                    <span class="relative">
                        Table of Contents
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            class="absolute left-full top-1/2 -translate-y-1/2 ml-1 size-4 opacity-60 group-hover/collapse:opacity-100
                            group-focus-visible/collapse:opacity-100 transition-opacity duration-150 motion-reduce:transition-none"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M6 15l6-6 6 6" />
                        </svg>
                    </span>
                </button>
            </h5>
            <button
                type="button"
                data-toc-expand
                aria-expanded="false"
                aria-controls="table-of-contents-sidebar-list"
                aria-label="Expand the table of contents"
                title="Table of Contents"
                class="hidden toc-collapsed:grid size-full place-items-center rounded-[inherit] cursor-pointer text-accent
                focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tertiary-500"
            >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
                </svg>
            </button>
            <!-- No `overscroll-contain`: a short list should let the page scroll under the pointer. -->
            <div
                id="table-of-contents-sidebar-list"
                data-toc-scroller
                class:list={['min-h-0 overflow-y-auto [scrollbar-width:thin] px-4 pt-3 pb-3 scroll-smooth motion-reduce:scroll-auto toc-collapsed:hidden', edgeFadeClasses]}
            >
                <div data-toc-list class="relative">
                    <span data-toc-bar aria-hidden="true" class:list={onScreenBarClasses} />
                    <ul class="text-[0.925rem] font-normal xl:font-medium xl:tracking-[.002rem]">
                        {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
                    </ul>
                </div>
            </div>
        </nav>
    )
}
{
    // Shaped like the strip, which takes over from it as the page scrolls. Glass like the sheet and the mobile navigation
    // menu, only clearer (`glass-clear`), rather than as opaque as the article it sits in. In light mode its glass shadow
    // is closer and wider than usual, so that it stands out from the pale article.
    // Opened, its list floats over the post rather than pushing it down: the placeholder keeps the closed card's place
    // (its title bar and 1px borders), and the card grows down from its top. tableOfContents.ts animates the list's
    // height as it opens and closes, and closes it when it's tapped or tabbed away from.
    hasToC && variant === 'inline' && (
        <div class="not-prose relative lg:hidden xl:toc-collapsed:block my-6 h-[calc(var(--toc-strip-height)+2px)]">
            <!-- Outside the summary, which mustn't hold a button. Above the card, so that the open list doesn't cover it. -->
            <button
                type="button"
                data-toc-expand
                aria-label="Show the table of contents beside the post"
                title="Show beside the post"
                class:list={[restoreButtonClasses, 'z-31']}
            >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="16" rx="2" />
                    <path d="M15 4v16" />
                </svg>
            </button>
            <details
                data-toc-inline
                class="group absolute inset-x-0 top-0 z-30 overflow-hidden rounded-box glass glass-clear
                not-dark:[--glass-shadow-y:16px] not-dark:[--glass-shadow-blur:40px] not-dark:[--glass-shadow-spread:-10px]
                not-dark:[--glass-shadow-alpha:0.42] not-dark:[--glass-contact-alpha:0.16]"
            >
                <summary
                    class="relative flex h-(--toc-strip-height) items-center justify-between gap-3 px-5 pb-3 cursor-pointer list-none
                    [&::-webkit-details-marker]:hidden rounded-box
                    focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-tertiary-500"
                >
                    <h5 id={titleId} class="font-serif text-base font-medium text-fg-1">Table of Contents</h5>
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        class="size-5 shrink-0 text-gray-temp-500 dark:text-gray-temp-300
                        transition-transform duration-450 ease-toc-arrive motion-reduce:transition-none group-data-expanded:rotate-180"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M6 9l6 6 6-6" />
                    </svg>
                    <TableOfContentsSegments sections={sections} />
                </summary>
                <!-- Unpadded, so its height can shrink to nothing -->
                <nav data-toc-inline-body aria-labelledby={titleId}>
                    <div class="px-5 pt-3 pb-3">
                        <div data-toc-list class="relative">
                            <span data-toc-bar aria-hidden="true" class:list={onScreenBarClasses} />
                            <ul class="text-[0.95rem]">
                                {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
                            </ul>
                        </div>
                    </div>
                </nav>
            </details>
        </div>
    )
}
{
    hasToC && variant === 'sheet' && (
        <>
            <button
                type="button"
                data-toc-button
                aria-label="Table of contents"
                aria-haspopup="dialog"
                class="sm:hidden print:hidden fixed right-4 bottom-4 z-40 grid size-11 place-items-center rounded-full
                cursor-pointer text-accent bg-bg-2 border border-fg-border-2 shadow-md backdrop-blur-xl
                invisible opacity-0 data-shown:visible data-shown:opacity-100
                transition-[opacity,visibility] duration-200 motion-reduce:transition-none
                focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tertiary-500"
            >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
                </svg>
            </button>
            <!--
              Opens focused on itself (`autofocus`), not on its close button, which would show its focus ring.
              tableOfContents.ts slides it in and out by toggling `data-shown` while it's open. Each way takes the
              timing function of where it's headed: easing out as it arrives, easing in as it leaves.
              As wide as the inline ToC: the card's width (up to --container-post) less its `--article-pad` and 1px border on each
              side, as in BlogArticle.astro. Its padding, corners and clearer glass (`glass-clear`) match the
              inline ToC's too. Like the mobile navigation menu (SiteHeader.astro, HeaderNav.astro), it floats as a glass
              card, clear of the bottom of the window, over the page dimmed and blurred the same way.
            -->
            <dialog
                data-toc-sheet
                aria-labelledby={titleId}
                autofocus
                tabindex="-1"
                class="fixed inset-x-0 top-auto bottom-4 mx-auto flex-col open:flex max-w-none max-h-[70dvh] overflow-hidden
                [--article-pad:clamp(1.25rem,5vw,2rem)] w-[calc(min(100%,var(--container-post))-2*(var(--article-pad)+1px))]
                rounded-box glass glass-clear text-fg-1 outline-none
                translate-y-[calc(100%+2rem)] data-shown:translate-y-0
                transition-[translate] duration-450 ease-toc-leave data-shown:ease-toc-arrive motion-reduce:transition-none
                backdrop:bg-gray-temp-900/10 dark:backdrop:bg-black/30 backdrop:backdrop-blur-[3px] backdrop:opacity-0 data-shown:backdrop:opacity-100
                backdrop:transition-opacity backdrop:duration-450 backdrop:ease-toc-leave data-shown:backdrop:ease-toc-arrive
                motion-reduce:backdrop:transition-none"
            >
                <!--
                  Stays put while the list scrolls. The title is centered, between the close button and a space as wide.
                  The progress segments run along its bottom, as under the inline ToC's and the strip's titles.
                -->
                <div class="relative grid shrink-0 grid-cols-[2.75rem_1fr_2.75rem] items-center px-2 pt-2 pb-4">
                    <span aria-hidden="true" />
                    <h5 id={titleId} class="text-center font-serif text-[1.0625rem] font-medium text-gray-temp-500 dark:text-gray-temp-300">
                        Table of Contents
                    </h5>
                    <button
                        type="button"
                        data-toc-close
                        aria-label="Close"
                        class="grid size-11 place-items-center rounded-full cursor-pointer
                        focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-tertiary-500"
                    >
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                    </button>
                    <TableOfContentsSegments sections={sections} />
                </div>
                <nav
                    data-toc-scroller
                    aria-labelledby={titleId}
                    class:list={['min-h-0 overflow-y-auto overscroll-contain px-5 pt-1 pb-4', edgeFadeClasses]}
                >
                    <div data-toc-list class="relative [--toc-bar-inset:8px]">
                        <span data-toc-bar aria-hidden="true" class:list={onScreenBarClasses} />
                        <ul class="text-[0.95rem]">
                            {toc.map((heading) => <TableOfContentsHeading heading={heading} roomy />)}
                        </ul>
                    </div>
                </nav>
            </dialog>
        </>
    )
}
{
    // The gutter, width and inset match the article's section, card and text in BlogArticle.astro (2rem is what
    // `--article-pad` comes to from `sm` up; the 1px is the card's border).
    // The same clearer glass as the inline ToC, which it takes over from.
    hasToC && variant === 'strip' && (
        <nav
            data-toc-strip
            aria-label="Jump to section"
            class="hidden sm:block lg:hidden xl:toc-collapsed:block print:hidden fixed inset-x-0 top-0 z-40 px-4 pt-(--toc-strip-top) pointer-events-none
            invisible -translate-y-full data-shown:visible data-shown:translate-y-0
            transition-[translate,visibility] duration-200 motion-reduce:transition-none"
        >
            <div class="w-full max-w-post mx-auto px-[calc(2rem+1px)]">
                <div
                    data-toc-strip-card
                    class="relative overflow-hidden pointer-events-auto rounded-box glass glass-clear
                    not-dark:[--glass-shadow-y:16px] not-dark:[--glass-shadow-blur:40px] not-dark:[--glass-shadow-spread:-10px]
                    not-dark:[--glass-shadow-alpha:0.42] not-dark:[--glass-contact-alpha:0.16]"
                >
                    <button
                        type="button"
                        data-toc-expand
                        aria-label="Show the table of contents beside the post"
                        title="Show beside the post"
                        class={restoreButtonClasses}
                    >
                        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M15 4v16" />
                        </svg>
                    </button>
                    <button
                        type="button"
                        aria-expanded="false"
                        aria-controls="table-of-contents-strip-panel"
                        class="relative flex h-(--toc-strip-height) w-full items-center justify-between gap-3 px-5 pb-3 text-left cursor-pointer
                        focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-tertiary-500"
                    >
                        <!-- In a subsection, its parent section comes first; it gives up its space before the current one does. -->
                        <span class="flex min-w-0 items-center gap-2 text-sm font-medium">
                            <span class="sr-only">Table of contents. Current section: </span>
                            <span data-toc-strip-parent class="min-w-0 shrink-[3] truncate text-gray-temp-500 dark:text-gray-temp-400 empty:hidden" />
                            <span aria-hidden="true" class="shrink-0 text-gray-temp-500 dark:text-gray-temp-400 [:empty+&]:hidden">›</span>
                            <span data-toc-strip-current class="min-w-0 truncate text-accent">{toc[0].text}</span>
                        </span>
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            class="size-5 shrink-0 text-gray-temp-500 dark:text-gray-temp-300
                            transition-transform duration-450 ease-toc-arrive motion-reduce:transition-none [[aria-expanded=true]>&]:rotate-180
                            xl:toc-collapsed:ml-10"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M6 9l6 6 6-6" />
                        </svg>
                        <TableOfContentsSegments sections={sections} />
                    </button>
                    <!-- tableOfContents.ts sets the height to the list's own, so the list keeps its size while it's revealed. -->
                    <div
                        id="table-of-contents-strip-panel"
                        class="h-0 overflow-hidden invisible data-open:visible
                        transition-[height,visibility] duration-450 ease-toc-leave data-open:ease-toc-arrive motion-reduce:transition-none"
                    >
                        <div data-toc-scroller class:list={['max-h-[70dvh] overflow-y-auto overscroll-contain px-5 pt-3 pb-3', topFadeClasses]}>
                            <div data-toc-list class="relative">
                                <span data-toc-bar aria-hidden="true" class:list={onScreenBarClasses} />
                                <ul class="text-[0.95rem]">
                                    {toc.map((heading) => <TableOfContentsHeading heading={heading} roomy />)}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    )
}
