---
// A top-level navigation item. On desktop a glass bead (in HeaderNav) sits under the active item and slides to whichever
// item is hovered or keyboard-focused. On mobile (inside the collapsible menu) items get a background tint instead.
type Props = {
    active?: boolean;
    class?: string;
};

const { active = false, class: className } = Astro.props;
---

<li
    class:list={[
        'nav-item relative rounded md:rounded-pill',
        'hover:bg-bg-2 md:hover:bg-transparent',
        // Text and icons (which use currentColor) take the primary color only on the item under the bead. HeaderNav's
        // script moves data-bead along with the bead; it starts on the active item so there is no flash before the script runs.
        'md:transition-colors md:duration-300 motion-reduce:transition-none',
        'md:data-bead:text-primary-700 md:dark:data-bead:text-primary-300',
        active && 'bg-bg-2 md:bg-transparent',
        className,
    ]}
    data-active={active || undefined}
    data-bead={active || undefined}
>
    <slot />
</li>
