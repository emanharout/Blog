---
import { slugifyTag } from '../scripts/utilities';

interface Props {
    tags: string[];
}

const { tags } = Astro.props;

const evenBgColor = 'bg-secondary-500 dark:bg-secondary-700';
const oddBgColor = 'bg-primary-500 dark:bg-primary-800';
---

<ul class="flex flex-wrap gap-1" aria-label="Tags">
    {
        tags.map((tag: string, index: number) => (
            <li>
                <a
                    href={`/tags/${slugifyTag(tag)}`}
                    class:list={[
                        'relative z-10 block px-1.5 py-1 text-fg-light rounded-lg text-xs hover:opacity-90',
                        { [evenBgColor]: index % 2 === 0 },
                        { [oddBgColor]: index % 2 === 1 },
                    ]}
                >
                    {tag}
                </a>
            </li>
        ))
    }
</ul>
