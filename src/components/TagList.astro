---
import Tag from './Tag.astro';

type Props = {
    tags: string[];
    // Hide the "Topics" label where the page's own title already says it (the all-topics page)
    showLabel?: boolean;
};

const { tags, showLabel = true } = Astro.props;
---

<div
    class="flex flex-col items-center gap-2 w-full max-w-4xl mt-2 mb-10 py-6 px-4
    bg-bg-2 border border-fg-border-2 rounded-lg shadow-md
    aero:glass aero:rounded-box
    sm:flex-row sm:items-baseline sm:gap-x-8 sm:px-8"
>
    {showLabel && <h2 class="font-serif text-xl text-fg-1">Topics</h2>}
    <ul
        class:list={[
            'flex flex-wrap justify-center items-center gap-2 py-2',
            showLabel ? 'sm:justify-start' : 'sm:mx-auto',
        ]}
    >
        {tags.map((tag, index) => <li><Tag tag={tag} tone={index % 2 === 0 ? 'primary' : 'secondary'} /></li>)}
    </ul>
</div>
