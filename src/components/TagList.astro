---
import Tag from './Tag.astro';

type Props = {
    tags: string[];
};

const { tags } = Astro.props;
---

<div
    class="flex flex-col items-center gap-2 w-full max-w-4xl mt-2 mb-10 py-6 px-4
    bg-bg-2 border border-fg-border-2 rounded-lg shadow-md
    sm:flex-row sm:items-baseline sm:gap-x-8 sm:px-8"
>
    <h2 class="text-lg font-semibold">TOPICS</h2>
    <ul class="flex flex-wrap justify-center sm:justify-start items-center gap-2 py-2">
        {tags.map((tag) => <li><Tag tag={tag} /></li>)}
    </ul>
</div>
