<!--
  The wordmark: the name in lowercase serif, in the text color with a touch of the accent color mixed in (warm ink by
  day, a rose-tinted white by night), pressed into the glass like letterpress: a light edge along the bottom of each
  letter and a shade along the top.
-->
<a href="/" class="block py-3 md:py-2" aria-label="Eman Harout, home">
    <span class="wordmark font-serif font-semibold text-2xl md:text-3xl leading-none tracking-tight whitespace-nowrap">
        eman harout
    </span>
</a>

<style>
    .wordmark {
        /* How much accent color is mixed into the text color */
        --wordmark-tint: 18%;
        color: color-mix(in oklab, var(--color-accent) var(--wordmark-tint), var(--color-fg-1));
        text-shadow:
            0 1px 0 rgb(255 255 255 / 0.9),
            0 -1px 0 rgb(0 0 0 / 0.18);
    }

    /* On the night sky a bright edge would glow, so the light edge is faint and the shade deeper */
    :global(.dark) .wordmark {
        text-shadow:
            0 1px 0 rgb(255 255 255 / 0.12),
            0 -1px 0 rgb(0 0 0 / 0.65);
    }
</style>
