---
import logo from '../assets/icons/Logo.png';
import { Picture } from 'astro:assets';
---

<a href="/" class="flex items-center gap-3 py-3 md:py-0" aria-label="Eman Harout, home">
    <Picture
        src={logo}
        alt=""
        width={40}
        height={40}
        formats={['avif', 'webp']}
        loading="eager"
        fallbackFormat="png"
        class="size-9 md:size-12"
    />
    <span class="font-serif text-xl md:text-2xl whitespace-nowrap">EMAN HAROUT</span>
</a>
