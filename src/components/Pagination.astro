---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { PaginationRepository } from '../scripts/pagination';

type Props = {
    pageData: PaginationRepository<CollectionEntry<'posts'>>;
};

const { pageData } = Astro.props;

const linkClasses = [
    'flex items-center justify-center min-w-10 px-3 h-10 leading-tight',
    'text-gray-temp-500 bg-bg-2 border border-fg-border-2',
    'dark:text-gray-temp-300',
    'hover:text-gray-temp-700 hover:bg-gray-temp-100',
    'dark:hover:text-gray-temp-50 dark:hover:bg-gray-temp-600',
];
---

<!-- Buttons share borders via -space-x-px; the first/last child gets the rounded corners. -->
<nav aria-label="Page navigation" class="flex justify-center items-center">
    <ul
        class="inline-flex -space-x-px text-sm rounded-lg shadow-md
        [&>li:first-child>*]:rounded-s-lg [&>li:last-child>*]:rounded-e-lg"
    >
        {
            pageData.showFirstPage && (
                <li>
                    <a href={pageData.firstPageUrl} class:list={linkClasses} aria-label="First page">
                        <Icon name="page-first-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        {
            pageData.showPreviousPage && (
                <li>
                    <a href={pageData.prevUrl} class:list={linkClasses} aria-label="Previous page">
                        <Icon name="page-previous-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        <!-- Raise the current page so its colored border isn't hidden behind a neighbor's border. -->
        <li class="relative z-10">
            <span
                aria-current="page"
                class="flex items-center justify-center min-w-10 px-3 h-10 leading-tight
                text-primary-600 bg-primary-50 border border-primary-300
                dark:text-primary-300 dark:bg-gray-temp-700 dark:border-gray-temp-600"
            >
                <span class="sr-only">Page </span>{pageData.currentPageNum}
            </span>
        </li>
        {
            pageData.showNextPage && (
                <li>
                    <a href={pageData.nextUrl} class:list={linkClasses} aria-label="Next page">
                        <Icon name="page-next-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        {
            pageData.showLastPage && (
                <li>
                    <a href={pageData.lastPageUrl} class:list={linkClasses} aria-label="Last page">
                        <Icon name="page-last-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
    </ul>
</nav>
