---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { PaginationRepository } from '../scripts/pagination';

type Props = {
    pageData: PaginationRepository<CollectionEntry<'posts'>>;
};

const { pageData } = Astro.props;

// Round glass buttons, like the footer's icon row: quiet until hovered, when they take a soft primary tint.
const linkClasses = [
    'grid size-10 place-items-center rounded-pill text-fg-2',
    'transition-colors duration-200 hover:bg-primary-500/12 hover:text-fg-1 motion-reduce:transition-none',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500',
];
---

<!-- One glass pill holding every control. The current page wears the nav bar's bead (HeaderNav.astro). -->
<nav aria-label="Page navigation" class="flex justify-center">
    <ul class="glass flex items-center gap-1 rounded-pill p-1.5 text-sm">
        {
            pageData.showFirstPage && (
                <li>
                    <a href={pageData.firstPageUrl} class:list={linkClasses} aria-label="First page">
                        <Icon name="page-first-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        {
            pageData.showPreviousPage && (
                <li>
                    <a href={pageData.prevUrl} class:list={linkClasses} aria-label="Previous page">
                        <Icon name="page-previous-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        <li>
            <span
                aria-current="page"
                class="page-bead grid size-10 place-items-center rounded-pill font-medium
                text-primary-700 dark:text-primary-300"
            >
                <span class="sr-only">Page </span>{pageData.currentPageNum}
            </span>
        </li>
        {
            pageData.showNextPage && (
                <li>
                    <a href={pageData.nextUrl} class:list={linkClasses} aria-label="Next page">
                        <Icon name="page-next-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
        {
            pageData.showLastPage && (
                <li>
                    <a href={pageData.lastPageUrl} class:list={linkClasses} aria-label="Last page">
                        <Icon name="page-last-icon" size="10" aria-hidden="true" />
                    </a>
                </li>
            )
        }
    </ul>
</nav>

<style>
    /* The same tinted glass bead as the nav bar's current item (HeaderNav.astro) */
    .page-bead {
        --bead-tint: hsl(var(--primary-color-500));
        background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 14%, rgb(255 255 255 / 0.95)),
            color-mix(in oklab, var(--bead-tint) 26%, rgb(255 255 255 / 0.7))
        );
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 1),
            0 1px 2px hsl(var(--glass-shadow-color) / 0.14),
            0 3px 8px -2px hsl(var(--glass-shadow-color) / 0.28);
    }

    :global(.dark) .page-bead {
        --bead-tint: hsl(var(--primary-color-300));
        background: linear-gradient(
            180deg,
            color-mix(in oklab, var(--bead-tint) 30%, transparent),
            color-mix(in oklab, var(--bead-tint) 12%, transparent)
        );
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.2),
            0 2px 6px -1px rgb(0 0 0 / 0.5);
    }
</style>
