---
import type { CollectionEntry } from 'astro:content';
import BlogGridCard from './BlogGridCard.astro';

type Props = {
    posts: CollectionEntry<'posts'>[];
};

const { posts } = Astro.props;
---

<!--
  Intrinsic grid: as many columns of at least 18rem as fit, sharing leftover space equally. No breakpoints needed.
  `auto-fill` (not `auto-fit`) keeps empty tracks, so a short list doesn't stretch into a few very wide cards.
-->
{posts.length === 0 && <p class="py-12 text-center text-fg-2">No posts here yet. Check back soon!</p>}
<ul
    class="grid gap-4 md:gap-5 xl:gap-6
    grid-cols-[repeat(auto-fill,minmax(min(18rem,100%),1fr))]"
>
    {posts.map((post) => <BlogGridCard post={post} />)}
</ul>
