---
import { slugifyTag } from '../scripts/utilities';

type Props = {
    tag: string;
};

const { tag } = Astro.props;
---

<a
    href={`/tags/${slugifyTag(tag)}`}
    class="py-[0.02rem] px-2 whitespace-nowrap
    text-sm font-normal text-fg-light rounded-lg
    bg-primary-600 dark:bg-primary-800
    hover:bg-primary-600/95
    border border-primary-900 dark:border-primary-950
    aero:rounded-pill aero:px-3 aero:py-0.5 aero:bg-primary-700 aero:dark:bg-primary-800
    aero:hover:bg-primary-600 aero:dark:hover:bg-primary-700
    aero:border-white/30 aero:dark:border-white/10
    aero:shadow-[inset_0_1px_0_hsl(0_0%_100%/0.25)]"
>
    {tag}
</a>
