---
import type { MarkdownHeading } from 'astro';

export interface HeadingHierarchy extends MarkdownHeading {
    subheadings: HeadingHierarchy[];
}

type Props = {
    heading: HeadingHierarchy;
};

const { heading } = Astro.props;
---

<!-- h3 headings are indented under their h2 -->
<li class:list={['leading-snug', { 'pl-4': heading.depth === 3 }]}>
    <!-- Active-section color is toggled by tableOfContents.ts via the `data-active` attribute. -->
    <a
        href={`#${heading.slug}`}
        class="table-of-content-link inline-block my-0.5 py-0.5
        text-gray-temp-500 hover:text-gray-temp-700 dark:text-gray-temp-400 dark:hover:text-gray-temp-300
        data-active:text-fg-primary-link-2 data-active:hover:text-fg-primary-link-2-hover"
    >
        {heading.text}
    </a>
    {
        heading.subheadings.length > 0 && (
            <ul>
                {heading.subheadings.map((subheading) => (
                    <Astro.self heading={subheading} />
                ))}
            </ul>
        )
    }
</li>
