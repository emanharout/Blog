---
import HeaderLogo from './HeaderLogo.astro';
import HeaderNav from './HeaderNav.astro';
---

<header class="container-page container-content bg-bg-1 text-fg-1">
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50
        focus:px-4 focus:py-2 focus:rounded focus:bg-bg-2 focus:shadow-md"
    >
        Skip to content
    </a>
    <div class="flex flex-wrap items-center justify-between gap-x-6">
        <HeaderLogo />
        <button
            id="site-nav-button"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-panel"
            class="md:hidden -mr-2 p-2 rounded hover:bg-bg-2"
        >
            <span class="sr-only">Menu</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path class="[[aria-expanded=true]_&]:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
                <path class="hidden [[aria-expanded=true]_&]:block" d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>
        <HeaderNav />
    </div>
</header>
<script src="../scripts/navigationDropdownMenu.ts"></script>
