---
import HeaderLogo from './HeaderLogo.astro';
import HeaderNav from './HeaderNav.astro';
---

<!-- Raised above the page while the mobile menu or the Blog dropdown is open, so they (and the backdrop) cover it -->
<header class="relative has-data-open:z-50 container-page container-content bg-bg-1 text-fg-1">
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50
        focus:px-4 focus:py-2 focus:rounded focus:bg-bg-2 focus:shadow-md"
    >
        Skip to content
    </a>
    <!-- Mobile only: blurs and dims the page behind the open menu card; tapping it closes the menu -->
    <div
        class="site-nav-backdrop fixed inset-0 -z-10 bg-gray-temp-900/10 backdrop-blur-[3px] dark:bg-black/30 md:hidden"
        aria-hidden="true"
    >
    </div>
    <div class="flex flex-wrap max-md:flex-nowrap items-center justify-between gap-x-6">
        <HeaderLogo />
        <!-- Mobile only: a glass button whose three lines fold into an X while the menu is open -->
        <button
            id="site-nav-button"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav-panel"
            class="site-nav-button md:hidden grid place-items-center size-11 rounded-full glass"
        >
            <span class="sr-only">Menu</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path class="menu-line menu-line-top" d="M4 7h16"></path>
                <path class="menu-line menu-line-middle" d="M4 12h16"></path>
                <path class="menu-line menu-line-bottom" d="M4 17h16"></path>
            </svg>
        </button>
        <HeaderNav />
    </div>
</header>
<script src="../scripts/navigationDropdownMenu.ts"></script>

<style>
    /*
     * One duration for every open and close animation in the header: the mobile menu card, its backdrop and button
     * icon, and the desktop Blog dropdown (HeaderNav reads it too).
     *
     * The header (with the menu card and backdrop inside it) is raised only while something is open (has-data-open:z-50).
     * Lowering it has to wait for the closing animation, or the page would cover the card and backdrop at once: the new
     * z-index applies right away on open, but only once the closing animation has finished.
     */
    header {
        --menu-duration: 450ms;
        transition: z-index 0s linear calc(var(--menu-duration) + 20ms) allow-discrete;
    }

    header:has([data-open]) {
        transition-delay: 0s;
    }

    /* Fades in and out in step with the card */
    .site-nav-backdrop {
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--menu-duration) ease-in;
    }

    header:has(#site-nav-panel[data-open]) .site-nav-backdrop {
        opacity: 1;
        pointer-events: auto;
        transition: opacity var(--menu-duration) ease-out;
    }

    .menu-line {
        transform-box: fill-box;
        transform-origin: center;
        transition:
            translate var(--menu-duration) cubic-bezier(0.3, 1.3, 0.5, 1),
            rotate var(--menu-duration) cubic-bezier(0.3, 1.3, 0.5, 1),
            opacity calc(var(--menu-duration) * 0.5) ease-out;
    }

    [aria-expanded='true'] .menu-line-top {
        translate: 0 5px;
        rotate: 45deg;
    }

    [aria-expanded='true'] .menu-line-middle {
        opacity: 0;
    }

    [aria-expanded='true'] .menu-line-bottom {
        translate: 0 -5px;
        rotate: -45deg;
    }

    @media (prefers-reduced-motion: reduce) {
        .menu-line,
        .site-nav-backdrop {
            transition: none;
        }
    }
</style>
