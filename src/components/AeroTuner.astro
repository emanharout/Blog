---
// Dev-only design tuner (rendered by MainLayout only when `import.meta.env.DEV`). Sliders adjust the --aero-* and
// --glass-* knobs from src/styles/input.css live, separately for light and dark mode. Changes are kept in this
// browser's localStorage (one set per light style); "Copy values" copies them as CSS so they can be made permanent.
// It also switches between the experimental light styles in src/scripts/lightStyles.ts.
import { LIGHT_STYLES } from '../scripts/lightStyles';

type Theme = 'light' | 'dark';
type Knob = {
    name: string;
    label: string;
    // Sliders by default; 'color' shows a color picker (value is a hex color); 'toggle' a checkbox (value 1 or 0)
    type?: 'range' | 'color' | 'toggle';
    min?: number;
    max?: number;
    step?: number;
    unit?: string;
    themes: Theme[];
    // Shared knobs set the same value in light and dark mode
    shared?: boolean;
    // Name of a toggle knob; this knob is greyed out and disabled while that toggle is off
    dependsOn?: string;
    // Optional live color preview
    swatch?: string;
    // Which light styles this knob applies to: 'default' (Refined Aero) or 'styled' (any experimental style).
    // Omitted means all.
    styles?: ('default' | 'styled')[];
};

const defaultOnly: ('default' | 'styled')[] = ['default'];
const styledOnly: ('default' | 'styled')[] = ['styled'];

const both: Theme[] = ['light', 'dark'];

const groups: { title: string; knobs: Knob[] }[] = [
    {
        title: 'Colors',
        knobs: [
            { name: 'aero-name-green', label: 'Name color', type: 'color', themes: ['light'] },
            { name: 'style-primary-h', label: 'Primary hue', min: 0, max: 360, step: 1, themes: ['light'], styles: styledOnly, swatch: 'hsl(var(--primary-color-600))' },
            { name: 'style-secondary-h', label: 'Secondary hue', min: 0, max: 360, step: 1, themes: ['light'], styles: styledOnly, swatch: 'hsl(var(--secondary-color-600))' },
            { name: 'style-deco', label: 'Decoration', min: 0, max: 2, step: 0.05, themes: ['light'], styles: styledOnly },
            { name: 'aero-sky-h', label: 'Sky blue', min: 180, max: 235, step: 1, themes: ['light'], styles: defaultOnly, swatch: 'hsl(var(--azure-color-500))' },
            { name: 'aero-leaf-h', label: 'Lawn green', min: 80, max: 175, step: 1, themes: ['light'], styles: defaultOnly, swatch: 'hsl(var(--leaf-color-500))' },
            { name: 'aero-sun-h', label: 'Sunshine', min: 25, max: 60, step: 1, themes: ['light'], styles: defaultOnly, swatch: 'hsl(var(--sun-color-400))' },
            { name: 'aero-sky-saturation', label: 'Sky saturation', min: 0, max: 1.6, step: 0.05, themes: ['light'], styles: defaultOnly, swatch: 'hsl(var(--aero-sky-h) calc(70% * var(--aero-sky-saturation)) calc(81% - 23% * var(--aero-sky-depth)))' },
            { name: 'aero-sky-depth', label: 'Sky depth', min: 0, max: 1, step: 0.05, themes: ['light'], styles: defaultOnly, swatch: 'hsl(var(--aero-sky-h) calc(70% * var(--aero-sky-saturation)) calc(81% - 23% * var(--aero-sky-depth)))' },
            { name: 'aero-sky-fade', label: 'Blue reaches down', min: 15, max: 82, step: 1, unit: '%', themes: ['light'], styles: defaultOnly },
            { name: 'aero-sun-strength', label: 'Sun glow', min: 0, max: 1, step: 0.05, themes: ['light'], styles: defaultOnly },
            { name: 'aero-rays', label: 'Window light', min: 0, max: 1, step: 0.05, themes: ['light'], styles: defaultOnly },
            { name: 'aero-horizon', label: 'Show gold band and lawn', type: 'toggle', themes: ['light'], styles: defaultOnly },
            { name: 'aero-lawn', label: 'Lawn', min: 0, max: 1, step: 0.05, themes: ['light'], styles: defaultOnly, dependsOn: 'aero-horizon' },
            { name: 'aero-lawn-height', label: 'Lawn height', min: 0.5, max: 3, step: 0.05, themes: ['light'], styles: defaultOnly, dependsOn: 'aero-horizon' },
            { name: 'aero-lawn-softness', label: 'Lawn edge (arches → mist)', min: 0, max: 1, step: 0.05, themes: ['light'], styles: defaultOnly, dependsOn: 'aero-horizon' },
            { name: 'aero-night-h', label: 'Navy hue', min: 200, max: 265, step: 1, themes: ['dark'], swatch: 'hsl(var(--night-color-600))' },
            { name: 'aero-night-l', label: 'Sky brightness', min: 2, max: 16, step: 0.5, unit: '%', themes: ['dark'], swatch: 'hsl(var(--aero-night-h) 68% var(--aero-night-l))' },
            { name: 'aero-dusk-h', label: 'Dusk hue', min: 215, max: 290, step: 1, themes: ['dark'], swatch: 'hsl(var(--dusk-color-500))' },
            { name: 'aero-stars', label: 'Stars', min: 0, max: 1, step: 0.05, themes: ['dark'] },
            { name: 'aero-moon-glow', label: 'Moon glow', min: 0, max: 2.5, step: 0.05, themes: ['dark'] },
            { name: 'aero-shooting-stars', label: 'Shooting stars', min: 0, max: 1, step: 0.05, themes: ['dark'] },
        ],
    },
    {
        title: 'Glass',
        knobs: [
            { name: 'glass-intensity', label: 'Glass intensity', min: 0, max: 2, step: 0.05, themes: both },
            { name: 'glass-rim', label: 'Rim light', min: 0, max: 1, step: 0.05, themes: both },
            { name: 'glass-shadow-depth', label: 'Shadow depth', min: 0, max: 2.5, step: 0.05, themes: both },
            { name: 'glass-boost', label: 'Color boost', min: 100, max: 300, step: 5, unit: '%', themes: both },
            { name: 'glass-opacity', label: 'Opacity', min: 0, max: 1, step: 0.01, themes: both },
            { name: 'glass-reading-opacity', label: 'Post panel opacity', min: 0, max: 1, step: 0.01, themes: both },
            { name: 'glass-blur', label: 'Frost (blur)', min: 0, max: 40, step: 1, unit: 'px', themes: both },
            { name: 'glass-gloss-alpha', label: 'Shine', min: 0, max: 1, step: 0.01, themes: both },
            { name: 'glass-edge-alpha', label: 'Edge', min: 0, max: 1, step: 0.01, themes: both },
        ],
    },
    {
        title: 'Shape',
        knobs: [
            { name: 'aero-radius-scale', label: 'Corner roundness (both modes)', min: 0, max: 2, step: 0.05, themes: both, shared: true },
        ],
    },
    {
        title: 'Motion',
        knobs: [{ name: 'aero-parallax', label: 'Scroll depth', min: 0, max: 3, step: 0.1, themes: both }],
    },
];
---

<div id="aero-tuner" class="fixed bottom-4 left-4 z-50 font-sans text-sm text-fg-1">
    <button
        id="aero-tuner-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="aero-tuner-panel"
        class="flex items-center gap-2 rounded-full border border-fg-border-2 bg-bg-2 px-3.5 py-2 font-medium shadow-lg
        backdrop-blur-xl hover:bg-bg-2/90"
    >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"></path>
            <circle cx="16" cy="6" r="2"></circle>
            <circle cx="10" cy="12" r="2"></circle>
            <circle cx="18" cy="18" r="2"></circle>
        </svg>
        Tune design
    </button>

    <div
        id="aero-tuner-panel"
        hidden
        class="absolute bottom-full left-0 mb-2 w-[min(20rem,calc(100vw-2rem))] max-h-[min(36rem,calc(100vh-6rem))]
        overflow-y-auto rounded-2xl border border-fg-border-2 bg-bg-2 p-4 shadow-xl backdrop-blur-2xl"
    >
        <div class="flex items-baseline justify-between gap-2">
            <h2 class="font-semibold">Design tuner</h2>
            <span class="text-xs text-fg-2">Tuning <strong id="aero-tuner-theme">light</strong> mode</span>
        </div>
        <p class="mt-1 text-xs text-fg-2">
            Switch the site theme to tune the other mode. Only visible in local development.
        </p>

        <label id="aero-tuner-style-row" class="mt-3 block">
            <span class="text-xs font-semibold uppercase tracking-wider text-fg-2">Light style</span>
            <select
                id="aero-tuner-style"
                class="mt-1 w-full rounded-md border border-fg-border-2 bg-bg-2 px-2 py-1.5 text-sm"
            >
                {LIGHT_STYLES.map((style) => <option value={style.id}>{style.name}</option>)}
            </select>
            <a href="/dev/compare" class="mt-1 inline-block text-xs text-primary-700 underline dark:text-primary-300">
                Compare all styles side by side
            </a>
        </label>

        {
            groups.map(({ title, knobs }) => (
                <fieldset class="mt-4">
                    <legend class="mb-1 text-xs font-semibold uppercase tracking-wider text-fg-2">{title}</legend>
                    {knobs.map((knob) => (
                        <label
                            class="aero-tuner-row mt-2 block transition-opacity data-disabled:opacity-40"
                            data-themes={knob.themes.join(' ')}
                            data-depends-on={knob.dependsOn}
                            data-styles={knob.styles?.join(' ')}
                        >
                            {knob.type === 'toggle' ? (
                                <span class="flex cursor-pointer items-center justify-between gap-2">
                                    {knob.label}
                                    <input
                                        type="checkbox"
                                        class="size-4 accent-primary-600"
                                        data-knob={knob.name}
                                        data-unit=""
                                    />
                                </span>
                            ) : (
                                <>
                                    <span class="flex items-center justify-between gap-2">
                                        <span class="flex items-center gap-2">
                                            {knob.swatch && (
                                                <span
                                                    class="inline-block size-3 rounded-full ring-1 ring-black/10 dark:ring-white/20"
                                                    style={`background: ${knob.swatch}`}
                                                    aria-hidden="true"
                                                />
                                            )}
                                            {knob.label}
                                        </span>
                                        <output class="tabular-nums text-xs text-fg-2" data-output-for={knob.name} />
                                    </span>
                                    <input
                                        type={knob.type ?? 'range'}
                                        class:list={[
                                            'mt-1',
                                            knob.type === 'color'
                                                ? 'h-8 w-full cursor-pointer rounded border border-fg-border-2 bg-transparent'
                                                : 'w-full accent-primary-600',
                                        ]}
                                        min={knob.min}
                                        max={knob.max}
                                        step={knob.step}
                                        data-knob={knob.name}
                                        data-unit={knob.unit ?? ''}
                                        data-shared={knob.shared ? '' : undefined}
                                    />
                                </>
                            )}
                        </label>
                    ))}
                </fieldset>
            ))
        }

        <div class="mt-5 flex flex-wrap gap-2">
            <button
                id="aero-tuner-copy"
                type="button"
                class="rounded-full bg-primary-700 px-3.5 py-1.5 font-medium text-white hover:bg-primary-600"
            >
                Copy values
            </button>
            <button
                id="aero-tuner-reset"
                type="button"
                class="rounded-full border border-fg-border-2 px-3.5 py-1.5 hover:bg-white/30 dark:hover:bg-white/10"
            >
                Reset this mode
            </button>
        </div>
        <p id="aero-tuner-status" class="mt-2 min-h-4 text-xs text-fg-2" aria-live="polite"></p>
    </div>
</div>

<script>
    // The tuner's code is a separate module so production builds (where DEV is false) drop it entirely.
    if (import.meta.env.DEV) import('../scripts/aeroTuner');
</script>
